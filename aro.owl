        <oboInOwl:hasDbXref>ChEMBL:CHEMBL1650818</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:115163</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>amdinocillin pivoxil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
