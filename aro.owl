    <!-- http://purl.obolibrary.org/obo/ARO_3000794 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000748"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000787"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MdtC is a transporter that forms a heteromultimer complex with MdtB to form a multidrug transporter. MdtBC is part of the MdtABC-TolC efflux complex. In the absence of MdtB, MdtC can form a homomultimer complex that results in a functioning efflux complex with a narrower drug specificity. mdtC corresponds to 3 loci in Pseudomonas aeruginosa PAO1 (gene name: muxC/muxB) and 3 loci in Pseudomonas aeruginosa LESB58.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mdtC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>yegO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000794</oboInOwl:id>
        <rdfs:label>mdtC</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000794"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>MdtC is a transporter that forms a heteromultimer complex with MdtB to form a multidrug transporter. MdtBC is part of the MdtABC-TolC efflux complex. In the absence of MdtB, MdtC can form a homomultimer complex that results in a functioning efflux complex with a narrower drug specificity. mdtC corresponds to 3 loci in Pseudomonas aeruginosa PAO1 (gene name: muxC/muxB) and 3 loci in Pseudomonas aeruginosa LESB58.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:12107133</oboInOwl:hasDbXref>
    </owl:Axiom>
