        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Flumequine is a first generation fluoroquinolone antibiotic. It is used primarily for the treatment of enteric infections in domestic species. It has been removed from clinical use and is no longer being marketed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:34729090</oboInOwl:hasDbXref>
