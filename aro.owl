    <!-- http://purl.obolibrary.org/obo/ARO_3003480 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003666"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Point mutations within the 530 loop of the 16S rRNA of Mycobacterium tuberculosis can result in resistance against streptomycin. These mutations do not directly inhibit the binding of streptomycin, but is hypothesized that they interfere with conformational perturbations that account for streptomycin&apos;s action on the ribosome.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mtub_16S_STR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rrs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003480</oboInOwl:id>
        <rdfs:label>Mycobacterium tuberculosis 16S rRNA mutation conferring resistance to streptomycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
