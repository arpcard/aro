    <!-- http://purl.obolibrary.org/obo/ARO_3000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000001"/>
        <obo:IAO_0000115>A mutation, single nucleotide polymorphism, gene, or gene product that confers antibiotic resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000000</oboInOwl:id>
