    <!-- http://purl.obolibrary.org/obo/ARO_3009554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007500"/>
        <obo:IAO_0000115>Imazalil is a member of the class of imidazoles.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:35554-44-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL356918</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:37175</oboInOwl:hasDbXref>
