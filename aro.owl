                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thiol transferase that leads to the resistance of fosfomycin. Contrasting FosA, FosB is dependent on the cofactor Magnesium (II) and uses either bacillithiol or  L-cysteine to open up the epoxide ring of fosfomycin.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PDB:4JH1</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>FosB</oboInOwl:hasExactSynonym>
