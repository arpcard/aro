        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002211"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000617"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mecA-type mecI repressor gene which mediates production of PBP2 by mecA. In methicillin-resistant Staphylococci possessing the mecA gene, mecI represses the expression of mecC thereby restoring or increasing susceptibility to methicillin and beta-lactam antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mecA-type_mecI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000124</oboInOwl:id>
        <rdfs:label>mecA-type mecI</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000124"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A mecA-type mecI repressor gene which mediates production of PBP2 by mecA. In methicillin-resistant Staphylococci possessing the mecA gene, mecI represses the expression of mecC thereby restoring or increasing susceptibility to methicillin and beta-lactam antibiotics.</owl:annotatedTarget>
