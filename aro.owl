    <!-- http://purl.obolibrary.org/obo/ARO_3009346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009311"/>
        <obo:IAO_0000115>Ase1 is found in fungi and is involved in the microtubule alignment of chromosomes during metaphase.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009346</oboInOwl:id>
        <rdfs:label>antifungal susceptible ase1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009349"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009348"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>ATP1 and 2 are mitochondrial enzymes linked to ATP production. Their disruption has been shown to confer resistance to azole drugs like clotrimazole.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009347</oboInOwl:id>
        <rdfs:label>Saccharomyces cerevisiae ATP1 with mutations conferring resistance to clotrimazole</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ATP1 and 2 are mitochondrial enzymes linked to ATP production. Their disruption has been shown to confer resistance to azole drugs like clotrimazole.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:40790106</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009199"/>
        <obo:IAO_0000115>ATP proteins in fungi are involved in ATP generation within the mitochondria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009348</oboInOwl:id>
        <rdfs:label>antifungal susceptible fungal ATP family protein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009349 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <obo:IAO_0000115>ATP1 and ATP2 are involved in ATP generation within the mitochondria. Mutation in these genes have been found to confer resistance against azole drugs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009349</oboInOwl:id>
        <rdfs:label>antifungal resistant ATP family enzyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009350 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009349"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
