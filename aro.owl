        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007760</oboInOwl:id>
        <rdfs:label>tulathromycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007760"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Tulathromycin is an antibacterial of the macrolide class of drugs. It is a 15-membered macrolide structure and considered a triamilide macrolide with three charged nitrogens. It is derived from azalide macrolides, such as azithromycin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16094557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007761 -->

