    <!-- http://purl.obolibrary.org/obo/ARO_3007528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007223"/>
        <obo:IAO_0000115>Gallic acid was found to enhance sulfonamides against multidrug-resistant S. suis. Gallic acid effectively disrupts the integrity and function of the cytoplasmic membrane by dissipating the proton motive force of bacteria. It regulates the expression of dihydrofolate reductase, which then inhibits tetrahydrofolate synthesis. As a result of polypharmacology, gallic acid can fully restore sulfadiazine sodium activity in the animal infection model without any drug resistances.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:149-91-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:30778</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL288114</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:370</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007528</oboInOwl:id>
        <rdfs:label>gallic acid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Gallic acid was found to enhance sulfonamides against multidrug-resistant S. suis. Gallic acid effectively disrupts the integrity and function of the cytoplasmic membrane by dissipating the proton motive force of bacteria. It regulates the expression of dihydrofolate reductase, which then inhibits tetrahydrofolate synthesis. As a result of polypharmacology, gallic acid can fully restore sulfadiazine sodium activity in the animal infection model without any drug resistances.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37125728</oboInOwl:hasDbXref>
    </owl:Axiom>
    


