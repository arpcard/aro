                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Point mutations in the dihydrofolate synthetase folC gene shown clinically to confer resistance to p-aminosalicylic acid or other aminosalicylates. Mutations in folC inhibit bioactivation of PAS and thus confer resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mtub_folC_PAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rv2447c</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004157</oboInOwl:id>
        <rdfs:label>Mycobacterium tuberculosis folC with mutation conferring resistance to para-aminosalicylic acid</rdfs:label>
    </owl:Class>
