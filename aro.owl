        <oboInOwl:hasDbXref>PubChem:69365</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003904</oboInOwl:id>
        <rdfs:label>formicin</rdfs:label>
    </owl:Class>
