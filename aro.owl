    <!-- http://purl.obolibrary.org/obo/ARO_3009412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009413"/>
