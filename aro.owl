        <oboInOwl:hasExactSynonym>netilyn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>netromycin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vectacin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000038</oboInOwl:id>
        <rdfs:label>netilmicin</rdfs:label>
    </owl:Class>
