    <!-- http://purl.obolibrary.org/obo/ARO_3003950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MsbA is a multidrug resistance transporter homolog from E. coli and belongs to a superfamily of transporters that contain an adenosine triphosphate (ATP) binding cassette (ABC) which is also called a nucleotide-binding domain (NBD). MsbA is a member of the MDR-ABC transporter group by sequence homology. MsbA transports lipid A, a major component of the bacterial outer cell membrane, and is the only bacterial ABC transporter that is essential for cell viability.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>msbA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003950</oboInOwl:id>
        <rdfs:label>msbA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>MsbA is a multidrug resistance transporter homolog from E. coli and belongs to a superfamily of transporters that contain an adenosine triphosphate (ATP) binding cassette (ABC) which is also called a nucleotide-binding domain (NBD). MsbA is a member of the MDR-ABC transporter group by sequence homology. MsbA transports lipid A, a major component of the bacterial outer cell membrane, and is the only bacterial ABC transporter that is essential for cell viability.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:12195740</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12358070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:19678712</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:27499013</oboInOwl:hasDbXref>
    </owl:Axiom>
