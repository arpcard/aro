        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004305"/>
        <obo:IAO_0000115>Any Enterococcus faecium or Enterococcus faecalis that has tested resistant (R) to vancomycin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>VRE</oboInOwl:hasExactSynonym>
