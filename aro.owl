    <!-- http://purl.obolibrary.org/obo/ARO_3009390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009392"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007501"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009391"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cdc6 is a gene involved in DNA replication initiation by forming and maintaining the pre-replicative complex and serving as a loading factor for the Mcm proteins onto chromatin. Its combination with a separate, seemingly independent FKS2 mutation results in echinocandin resistance that is more prominent than echinocandin resistance conferred by the FKS2 mutation alone.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Candida glabrata</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009390</oboInOwl:id>
        <rdfs:label>Nakaseomyces glabratus Cdc6 with mutations conferring resistance against caspofungin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009390"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cdc6 is a gene involved in DNA replication initiation by forming and maintaining the pre-replicative complex and serving as a loading factor for the Mcm proteins onto chromatin. Its combination with a separate, seemingly independent FKS2 mutation results in echinocandin resistance that is more prominent than echinocandin resistance conferred by the FKS2 mutation alone.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22615574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:40790106</oboInOwl:hasDbXref>
    </owl:Axiom>
    


