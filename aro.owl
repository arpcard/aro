            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A family of RlmK-like lincosamide-resistant 23S rRNA methyltransferases. The only member of the family discovered so far was isolated from Paenibacillus sp. LC231, a strain found in Lechuguilla Cave, NM, USA with resistance exclusively observed for clindamycin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004273</oboInOwl:id>
        <rdfs:label>Llm 23S ribosomal RNA methyltransferase</rdfs:label>
    </owl:Class>
