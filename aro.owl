    <!-- http://purl.obolibrary.org/obo/ARO_0000046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000017"/>
        <obo:IAO_0000115>Lincomycin is a lincosamide antibiotic that comes from the actinomyces Streptomyces lincolnensis. It binds to the 23s portion of the 50S subunit of bacterial ribosomes and inhibit early elongation of peptide chain by inhibiting transpeptidase reaction.</obo:IAO_0000115>
