        <oboInOwl:hasDbXref>CHEBI:9169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL221886</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:36119</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>antibiotic 6640</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dehydrogentamicin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>rickamicin</oboInOwl:hasExactSynonym>
