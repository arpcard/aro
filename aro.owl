    <!-- http://purl.obolibrary.org/obo/ARO_3000674 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000034"/>
        <obo:IAO_0000115>Dalfopristin is a water-soluble semi-synthetic derivative of pristinamycin IIA. It is produced by Streptomyces pristinaespiralis and is used in combination with quinupristin in a 7:3 ratio. Both work together to inhibit protein synthesis, and is active against Gram-positive bacteria.</obo:IAO_0000115>
