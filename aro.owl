    <!-- http://purl.obolibrary.org/obo/ARO_3004017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009107"/>
        <obo:IAO_0000115>Moxalactam (Latamoxef) is a broad spectrum cephalosporin (oxacephem) and beta-lactam antibiotic. Moxalactam binding to PBPs inhibits peptidoglycan cross-linkage in the cell wall, resulting in cell death. Moxalactam is proposed to be effective against meningitides as it passes the blood-brain barrier.</obo:IAO_0000115>
