                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009322"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Mutations in the beta tubulin gene of phytopathogenic fungi have shown to cause resistance against the strobilurin class of antifungal pesticides which target mitochondrial cellular respiration.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009471</oboInOwl:id>
        <rdfs:label>Colletotrichum siamense beta-tubulin with mutations conferring resistance to azoxystrobin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009318"/>
        <obo:IAO_0000115>While strobilurin fungicides target mitochondrial cellular respiration activity, mutations in beta tubulin can reduce their efficacy thereby conferring resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009472</oboInOwl:id>
        <rdfs:label>strobilurin resistant beta tubulin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009432"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009322"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Mutations in the beta tubulin gene of phytopathogenic fungi have shown to cause resistance against the benzimidazole class of antifungal pesticides, which target beta-tubulin. Thiabendazole is a unique member of the benzimidazole class that can be used for human treatment. Benzimidazoles like thiabendazole are structurally defined as imidazole rings fused to benzene rings.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009473</oboInOwl:id>
        <rdfs:label>Colletotrichum musae beta-tubulin with mutations conferring resistance to thiabendazole</rdfs:label>
    </owl:Class>
    


