        <obo:IAO_0000115>FOX beta-lactamases are plasmid-encoded AmpC-type beta-lactamase which conferred resistance to broad-spectrum cephalosporins and cephamycins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000067</oboInOwl:id>
        <rdfs:label>FOX beta-lactamase</rdfs:label>
    </owl:Class>
