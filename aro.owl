    <!-- http://purl.obolibrary.org/obo/ARO_3000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000133"/>
