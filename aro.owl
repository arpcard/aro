    <!-- http://purl.obolibrary.org/obo/ARO_3007063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007226"/>
        <obo:IAO_0000115>Cilastatin is often prescribed with imipenem as a beta-lactam potentiator. Cilastatin inhibits enzymatic renal dehydropeptidase, which hydrolyzes imipenem, thereby preventing the metabolism of imipenem in vivo and maintaining longer antibiotic exposure and effect.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:82009-34-5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:3697</oboInOwl:hasDbXref>
