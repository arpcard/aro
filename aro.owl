    <!-- http://purl.obolibrary.org/obo/ARO_3009209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009194"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007504"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Polyenes like amphotericin B target ergosterol embedded in the fungal cell membrane. Mutations in Cyp51 can affect either the presence of ergosterol, or the structure of ergosterol thereby altering polyene target, and rendering such compounds ineffective.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009209</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus cyp51a with mutations conferring resistance to amphotericin B</rdfs:label>
    </owl:Class>
    


