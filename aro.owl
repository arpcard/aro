    <!-- http://purl.obolibrary.org/obo/ARO_3009230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009365"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007513"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009234"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The Hmg pathway is a primarily metabolic pathway that contributes to various functions inclusive of steroid synthesis. In fungi, the synthesis of a steroid precursor is vital to the eventual formation of ergosterol which is an integral part of the fungal cell membrane. Mutations in the Hmg gene have shown conferred resistance in certain fungi against azole drugs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009230</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Hmg1 with mutations conferring resistance to posaconazole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007546"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007501"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
