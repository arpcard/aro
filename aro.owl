            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>This inducible cluster confers high resistance to both vancomycin and teicoplanin by allowing restructuring of peptidoglycan precursors to end in D-Ala-D-Lac. The vanA gene cluster can be located either on plasmids or on the chromosome. Gene orientation: vanRSHAXYZ.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>vanA_cluster</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000236</oboInOwl:id>
        <rdfs:label>glycopeptide resistance gene cluster VanA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
