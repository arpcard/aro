            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Efflux protein facT confers resistance to factumycin. The gene has been heterologously expressed in S. coelicolor and its function confirmed. It is possible that this gene can export other kirromycin-like elfamycins, but this has not been tested.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>facT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3001313</oboInOwl:id>
        <rdfs:label>facT</rdfs:label>
    </owl:Class>
    <owl:Axiom>
