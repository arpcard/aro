                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Enoyl-acyl carrier reductases catalyze the final enoyl reduction step in bacterial type II fatty acid elongation. Triclosan antibiotics block enoyl reduction and therefore fatty acid synthesis, functioning as a broad spectrum biocide and antibiotic.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000872</oboInOwl:id>
        <rdfs:label>antibiotic sensitive enoyl-acyl carrier reductase</rdfs:label>
    </owl:Class>
