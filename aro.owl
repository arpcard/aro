    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115>Lascufloxacin is a fluoroquinolone antibiotic.</obo:IAO_0000115>
