                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000106"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Aminoglycoside acetyltransferase enzymes modify aminoglycoside antibiotics by catalyzing the transfer of an acetyl group to one of the amino groups present in aminoglycosides, using acetyl coenzyme A as a donor substrate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>aminoglycoside N-acetyltransferase</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
