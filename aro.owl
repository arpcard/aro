            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>ADE17 encodes essential proteins involved in purine biosynthesis. Mutations to this gene within fungi can be associated with multidrug antifungal resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Candidozyma auris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009329</oboInOwl:id>
        <rdfs:label>Candida auris ADE17 with mutations conferring resistance to caspofungin</rdfs:label>
    </owl:Class>
    


