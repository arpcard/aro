    <!-- http://purl.obolibrary.org/obo/ARO_3000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000020"/>
        <obo:IAO_0000115>Imipenem is a broad-spectrum antibiotic and is usually taken with cilastatin, which prevents hydrolysis of imipenem by renal dehydropeptidase-I. It is resistant to hydrolysis by most other beta-lactamases. Notable exceptions are the KPC beta-lactamases and Ambler Class B enzymes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:64221-86-9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:471744</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL148</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:104838</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>IMI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000170</oboInOwl:id>
        <rdfs:label>imipenem</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Imipenem is a broad-spectrum antibiotic and is usually taken with cilastatin, which prevents hydrolysis of imipenem by renal dehydropeptidase-I. It is resistant to hydrolysis by most other beta-lactamases. Notable exceptions are the KPC beta-lactamases and Ambler Class B enzymes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:10629005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12084099</oboInOwl:hasDbXref>
    </owl:Axiom>
    


