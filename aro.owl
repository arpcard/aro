    <!-- http://purl.obolibrary.org/obo/ARO_3003256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000766"/>
        <obo:IAO_0000115>ParC is a subunit of topoisomerase IV, which decatenates and relaxes DNA to allow access to genes for transcription or translation. Targeting topoisomerase IV inhibits DNA synthesis, and may also lead to double-stranded cell breaks.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003256</oboInOwl:id>
        <rdfs:label>antibiotic sensitive DNA topoisomerase subunit parC</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ParC is a subunit of topoisomerase IV, which decatenates and relaxes DNA to allow access to genes for transcription or translation. Targeting topoisomerase IV inhibits DNA synthesis, and may also lead to double-stranded cell breaks.</owl:annotatedTarget>
