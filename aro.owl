                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>OXY beta-lactamases are chromosomal class A beta-lactamases that are found in Klebsiella oxytoca. At constitutive low levels, OXY beta-lactamases confer resistance to aminopenicillins and carboxypenicillins. At high induced levels,  OXY beta-lactamases confer resistance to penicillins, cephalosporins and aztreonam.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>K1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>KOXY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3002388</oboInOwl:id>
        <rdfs:label>OXY beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
