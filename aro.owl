    <!-- http://purl.obolibrary.org/obo/ARO_3009172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007496"/>
        <obo:IAO_0000115>This compound inhibits 1,3-beta-glucan synthase in fungi (primarily yeasts), which is a major compound of cell wall synthesis.</obo:IAO_0000115>
