    <!-- http://purl.obolibrary.org/obo/ARO_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
        <obo:IAO_0000115>Kanamycin is an aminoglycoside antibiotic used to treat different types of bacterial infections. Kanamycin works by binding to the bacterial 30S ribosomal subunit, causing misreading of mRNA and leaving the bacterium unable to synthesize proteins vital to its growth.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:59-01-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:17630</oboInOwl:hasDbXref>
