    <!-- http://purl.obolibrary.org/obo/ARO_0000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009123"/>
        <obo:IAO_0000115>Piperacillin is an acetylureidopenicillin and has an extended spectrum of targets relative to other beta-lactam antibiotics. It inhibits cell wall synthesis in bacteria, and is usually taken with the beta-lactamase inhibitor tazobactam to overcome penicillin-resistant bacteria.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:61477-96-1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:8232</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL702</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:43672</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Piperacillin anhydrous</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Piperacillin sodium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pipercillin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pipracil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pipril</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000078</oboInOwl:id>
        <rdfs:label>piperacillin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_0000078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Piperacillin is an acetylureidopenicillin and has an extended spectrum of targets relative to other beta-lactam antibiotics. It inhibits cell wall synthesis in bacteria, and is usually taken with the beta-lactamase inhibitor tazobactam to overcome penicillin-resistant bacteria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:11735679</oboInOwl:hasDbXref>
    </owl:Axiom>
    


