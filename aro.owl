        <obo:IAO_0000115>SoxR is a sensory protein that upregulates soxS expression in the presence of redox-cycling drugs. This stress response leads to the expression many multidrug efflux pumps. In Pseudomonas aeruginosa, which lacks SoxS, SoxR is able to directly upregulate the expression of the MexGHI-OpmD efflux pump.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000836</oboInOwl:id>
        <rdfs:label>soxR</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>SoxR is a sensory protein that upregulates soxS expression in the presence of redox-cycling drugs. This stress response leads to the expression many multidrug efflux pumps. In Pseudomonas aeruginosa, which lacks SoxS, SoxR is able to directly upregulate the expression of the MexGHI-OpmD efflux pump.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:15845502</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21226770</oboInOwl:hasDbXref>
    </owl:Axiom>
    


