            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>D-Alanine synthetase (or ligase), also known as ddla, joins two D-alanines before their addition to the pentapeptide chains of peptidoglycan. It is found in both Gram-positive and Gram-negative bacteria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000723</oboInOwl:id>
        <rdfs:label>cycloserine sensitive D-alanine synthetase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000723"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>D-Alanine synthetase (or ligase), also known as ddla, joins two D-alanines before their addition to the pentapeptide chains of peptidoglycan. It is found in both Gram-positive and Gram-negative bacteria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:14479178</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000724 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000724">
