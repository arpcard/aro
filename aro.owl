        </rdfs:subClassOf>
        <obo:IAO_0000115>ErmN is a methyltransferase found in the tylosin producer Streptomyces fradiae. Like other Erm enzymes, it catalyzes the methylation of A2058 of the 23S ribosomal RNA. Specifically, this enzyme transfers only one methyl group. The gene is found in the tylosin biosynthetic cluster and is responsible for self-resistance to tylosin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ErmN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tlrD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000592</oboInOwl:id>
        <rdfs:label>ErmN</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000592"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ErmN is a methyltransferase found in the tylosin producer Streptomyces fradiae. Like other Erm enzymes, it catalyzes the methylation of A2058 of the 23S ribosomal RNA. Specifically, this enzyme transfers only one methyl group. The gene is found in the tylosin biosynthetic cluster and is responsible for self-resistance to tylosin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:12019067</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:12417742</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:8973363</oboInOwl:hasDbXref>
    </owl:Axiom>
