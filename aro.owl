            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>tlyA encodes for hemolysin. It Catalyzes the 2&apos;-O-methylation at nucleotides C1409 in 16S rRNA and C1920 in 23S rRNA. Mutation that arise within this gene reduces the binding affinity of aminoglycosides to rRNA.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003443</oboInOwl:id>
        <rdfs:label>antibiotic resistant tlyA</rdfs:label>
    </owl:Class>
