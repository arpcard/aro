    <!-- http://purl.obolibrary.org/obo/ARO_3009431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009432"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009322"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Mutations in the beta tubulin gene of phytopathogenic fungi have shown to cause resistance against the benzimidazole class of antifungal pesticides, which target beta-tubulin. Thiabendazole is a unique member of the benzimidazole class that can be used for human treatment. Benzimidazoles like thiabendazole are structurally defined as imidazole rings fused to benzene rings.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009431</oboInOwl:id>
        <rdfs:label>Fusarium graminearum beta-tubulin with mutations conferring resistance to thiabendazole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009317"/>
        <obo:IAO_0000115>Thiabendazole is a unique member of the benzimidazole class that can be used for human treatment.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:148-79-8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL625</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:5430</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009432</oboInOwl:id>
        <rdfs:label>thiabendazole</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009432"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Thiabendazole is a unique member of the benzimidazole class that can be used for human treatment.</owl:annotatedTarget>
