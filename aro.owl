    <!-- http://purl.obolibrary.org/obo/ARO_3003731 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3005086"/>
        <rdfs:subClassOf>
