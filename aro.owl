    <!-- http://purl.obolibrary.org/obo/ARO_3009342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010001"/>
        <obo:IAO_0000115>In fungi, AFR directly encodes an ABC pump that allows for a baseline efflux of antifungal drugs, especially azoles. It&apos;s mutation can cause antifungal resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009342</oboInOwl:id>
        <rdfs:label>fungal AFR</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007508"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In fungi, AFR directly encodes an ABC pump that allows for a baseline efflux of antifungal drugs, especially azoles. Mutations can result in excessive efflux of these drugs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009343</oboInOwl:id>
        <rdfs:label>Cryptococcus neoformans AFR1 with mutations conferring resistance against fluconazole</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009343"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>In fungi, AFR directly encodes an ABC pump that allows for a baseline efflux of antifungal drugs, especially azoles. Mutations can result in excessive efflux of these drugs.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:12519188</oboInOwl:hasDbXref>
    </owl:Axiom>
    


