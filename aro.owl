                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A category of aminoglycoside O-nucleotidyltransferase enzymes with modification regiospecificity based at the 6-hydroxyl group of the respective antibiotic. These enzymes inactivate aminoglycoside antibiotics, specifically streptomycin, by transfer of an AMP group from an ATP substrate to the 6-hydroxyl group of the compound.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000225</oboInOwl:id>
        <rdfs:label>ANT(6)</rdfs:label>
    </owl:Class>
    


