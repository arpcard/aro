    <!-- http://purl.obolibrary.org/obo/ARO_3007111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>nimI is a nitroimidazole reductase discovered in the Prevotella baroniae that is associated with the deactivation of nitroimidazole antibiotics such as metronidazole. Although not found in Bacteroids fragilis, the source organism of most nim genes, nimI shares significant similarity with other nitroimidazole reductases. nimI is chromosomally encoded in P. baroniae, suggesting that it is intrinsic to this species.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>nimI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007111</oboInOwl:id>
        <rdfs:label>nimI</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>nimI is a nitroimidazole reductase discovered in the Prevotella baroniae that is associated with the deactivation of nitroimidazole antibiotics such as metronidazole. Although not found in Bacteroids fragilis, the source organism of most nim genes, nimI shares significant similarity with other nitroimidazole reductases. nimI is chromosomally encoded in P. baroniae, suggesting that it is intrinsic to this species.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19805556</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007111"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>nimI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


