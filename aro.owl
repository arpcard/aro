    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000711"/>
        <obo:IAO_0000115>This enzyme is essential to the purine biosynthesis pathway in wild-type eukaryotes including fungi.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009330</oboInOwl:id>
        <rdfs:label>antibiotic sensitive 5-aminoimidazole-4-carboxamide ribonucleotide transformylase</rdfs:label>
    </owl:Class>
    


