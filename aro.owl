        <oboInOwl:hasDbXref>PMID:21576441</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000000"/>
        <obo:IAO_0000115>This category includes modulating enzymes that regulate downstream enzymes or genes that will ultimately confer resistance against an antimicrobial compound.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009424</oboInOwl:id>
        <rdfs:label>resistance conferring transcription factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009425 -->

