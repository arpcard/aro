    <!-- http://purl.obolibrary.org/obo/ARO_3003276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3003277"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>RNA polymerase is a multisubunit enzyme that is necessary for transcription. The beta-subunit of RNA polymerase forms the active center of the enzyme and template/transcript binding sites. Mutations in rpoB gene confers antibiotic resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>RNA polymerase beta subunit</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003276</oboInOwl:id>
        <rdfs:label>antibiotic resistant rpoB</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000712"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000007"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
