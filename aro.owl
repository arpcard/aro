        <oboInOwl:hasDbXref>PubChem:5282521</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007472</oboInOwl:id>
        <rdfs:label>tilmicosin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007472"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Tilmicosin is a macrolide antibiotic used for livestock and poultry synthesized from tylomycin. It is mainly used to treat common bacterial infections and diseases caused by mycoplasma infection in livestock and poultry breeding. Tilmicosin has broad-spectrum antibacterial properties and has a strong inhibitory effect on most Gram positive and negative bacteria.</owl:annotatedTarget>
