                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000106"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Edeine acetyltransferase enzymes catalyze the transfer of an acetyl group to active edeine, converting it to an inactive form in vivo. This mechanism is used for high-level self-resistance in edeine-producing Brevibacillus spp.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004064</oboInOwl:id>
        <rdfs:label>Edeine acetyltransferase</rdfs:label>
