                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>AmvA has 14 alpha-helical transmembrane segments, qualifying it as a member of the DHA2 transporter family of the major facilitator superfamily (MFS). When AmvA was expressed in E. coli,  the cells had at least four-fold decreased susceptibility to erythromycin, acridine orange, acriflavine, deoxycholate and methyl viologen. AmvA from the AC0037 strain of A. baumannii was tested.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Abau_AmvA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>B0V737</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004577</oboInOwl:id>
        <rdfs:label>Acinetobacter baumannii AmvA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004577"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>AmvA has 14 alpha-helical transmembrane segments, qualifying it as a member of the DHA2 transporter family of the major facilitator superfamily (MFS). When AmvA was expressed in E. coli,  the cells had at least four-fold decreased susceptibility to erythromycin, acridine orange, acriflavine, deoxycholate and methyl viologen. AmvA from the AC0037 strain of A. baumannii was tested.</owl:annotatedTarget>
