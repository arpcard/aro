            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>ethA is a monooxygenase that is able to convert a wide range of ketones to the corresponding esters or lactones via a Baeyer-Villiger oxidation reaction. Is responsible for the activation of several thiocarbamide-containing pro-drugs into cytotoxic species.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003475</oboInOwl:id>
        <rdfs:label>Antibiotic sensitive ethA</rdfs:label>
    </owl:Class>
    


