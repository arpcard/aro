    <!-- http://purl.obolibrary.org/obo/ARO_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000081"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000707"/>
        <obo:IAO_0000115>Bleomycin is a family of glycopeptide antibiotics produced by the bacterium Streptomyces verticillus. Bleomycins, taken as a mixture, act by the induction of DNA and RNA strand breaks. In addition to its antibacterial activity, bleomycin is also used as an anticancer agent.</obo:IAO_0000115>
