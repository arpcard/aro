            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The Mdr gene is responsible for synthesis of the ABC class of efflux pumps. Mutation in this gene can result in resistance against azole drugs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009446</oboInOwl:id>
        <rdfs:label>Candida tropicalis MDR1 with mutations conferring resistance to voriconazole</rdfs:label>
    </owl:Class>
    


