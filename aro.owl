            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007293"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>mrdA is a peptidoglycan DD-transpeptidase. Mutations in mrdA have been shown to confer resistance to penicillin-like antibiotics, such as durlobactam.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ecol_mrdA_DUR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009337</oboInOwl:id>
        <rdfs:label>Escherichia coli PBP2-like mrdA with mutation conferring resistance to durlobactam</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>mrdA is a peptidoglycan DD-transpeptidase. Mutations in mrdA have been shown to confer resistance to penicillin-like antibiotics, such as durlobactam.</owl:annotatedTarget>
