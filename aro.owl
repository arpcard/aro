    <!-- http://purl.obolibrary.org/obo/ARO_3007671 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Clostridioides difficile nimB is a heme-dependent flavin enzyme that degrades nitroimidazoles to amines lacking antimicrobial activity. NimB expression alone is not sufficient for nitroimidazole resistance. Constitutive transcription of nimB, which is driven by a mutation in the promoter PnimBG, is a mechanism of clinically-relevant heme-dependent metronidazole resistance in C. difficile.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>C. difficile nimB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CdnimB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007671</oboInOwl:id>
        <rdfs:label>Clostridioides difficile nimB</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007671"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Clostridioides difficile nimB is a heme-dependent flavin enzyme that degrades nitroimidazoles to amines lacking antimicrobial activity. NimB expression alone is not sufficient for nitroimidazole resistance. Constitutive transcription of nimB, which is driven by a mutation in the promoter PnimBG, is a mechanism of clinically-relevant heme-dependent metronidazole resistance in C. difficile.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37438331</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007671"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>CdnimB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


