    <!-- http://purl.obolibrary.org/obo/ARO_3000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009657"/>
        <obo:IAO_0000115>Edeine B is a subtype of the peptide antibiotic edeine, composed of beta-tyr, beta-ser, diaminopropionic acid, diaminohydroxyazelaic acid, glycine, and guanylspermidine. Edeine B is a mixture of edeine B1 and its inactive isomer, edeine B2.  Edeines bind to the 30S subunit to block fMet-tRNA interaction at the P site, inhibiting protein synthesis and subsequent structure/function processes critical for life or replication. Edeine B has also been shown to inhibit septation and cause filamentous morphology, also leading to cell death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PubChem:446232</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000134</oboInOwl:id>
        <rdfs:label>edeine B</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000134"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Edeine B is a subtype of the peptide antibiotic edeine, composed of beta-tyr, beta-ser, diaminopropionic acid, diaminohydroxyazelaic acid, glycine, and guanylspermidine. Edeine B is a mixture of edeine B1 and its inactive isomer, edeine B2.  Edeines bind to the 30S subunit to block fMet-tRNA interaction at the P site, inhibiting protein synthesis and subsequent structure/function processes critical for life or replication. Edeine B has also been shown to inhibit septation and cause filamentous morphology, also leading to cell death.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:20410587</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:4984939</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:70202</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000135 -->

