        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000872"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Enoyl-acyl carrier reductases catalyze the final enoyl reduction step in bacterial type II fatty acid elongation. Triclosan antibiotics block enoyl reduction and therefore fatty acid synthesis, functioning as a broad spectrum biocide and antibiotic.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:14736233</oboInOwl:hasDbXref>
    </owl:Axiom>
    


