    <!-- http://purl.obolibrary.org/obo/ARO_3000704 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009105"/>
        <obo:IAO_0000115>Cefalotin is a semisynthetic cephalosporin antibiotic activate against staphylococci. It is resistant to staphylococci beta-lactamases but hydrolyzed by enterobacterial beta-lactamases.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:153-61-7</oboInOwl:hasDbXref>
