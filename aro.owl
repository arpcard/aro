    <!-- http://purl.obolibrary.org/obo/ARO_3005175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3005175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007161"/>
        <obo:IAO_0000115>Perchlozone is a novel thiosemicarbazone used for the treatment of multidrug-resistant tuberculosis. It is similar to thiacetazone with only a different side chain attached to the thiosemicarbazone moiety. Perchlozone is a prodrug that is activated by ethA and inhibits the HadABC complex.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PubChem:5374694</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>4-thioureido-iminomethylpyridinium perchlorate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3005175</oboInOwl:id>
        <rdfs:label>perchlozone</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3005175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Perchlozone is a novel thiosemicarbazone used for the treatment of multidrug-resistant tuberculosis. It is similar to thiacetazone with only a different side chain attached to the thiosemicarbazone moiety. Perchlozone is a prodrug that is activated by ethA and inhibits the HadABC complex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25704063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:33022959</oboInOwl:hasDbXref>
    </owl:Axiom>
    


