        <oboInOwl:hasExactSynonym>Aspidium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kanamicina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kanamycin sulfate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kanamycine</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kanamycinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kantrex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>kanamycin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000049</oboInOwl:id>
        <rdfs:label>kanamycin A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_0000049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Kanamycin is an aminoglycoside antibiotic used to treat different types of bacterial infections. Kanamycin works by binding to the bacterial 30S ribosomal subunit, causing misreading of mRNA and leaving the bacterium unable to synthesize proteins vital to its growth.</owl:annotatedTarget>
