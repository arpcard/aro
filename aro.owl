    <!-- http://purl.obolibrary.org/obo/ARO_3007763 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000000"/>
        <obo:IAO_0000115>Four antitumor-antibiotics of a new structure class, the marinomycins A-D (1-4), were isolated from the saline culture of a new group of marine actinomycetes. The structures of the marinomycins are unusual macrodiolides composed of dimeric 2-hydroxy-6-alkenyl-benzoic acid lactones with conjugated tetraene-pentahydroxy polyketide chains.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007763</oboInOwl:id>
        <rdfs:label>Marinomycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007763"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Four antitumor-antibiotics of a new structure class, the marinomycins A-D (1-4), were isolated from the saline culture of a new group of marine actinomycetes. The structures of the marinomycins are unusual macrodiolides composed of dimeric 2-hydroxy-6-alkenyl-benzoic acid lactones with conjugated tetraene-pentahydroxy polyketide chains.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16448135</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007764 -->

