    <!-- http://purl.obolibrary.org/obo/ARO_3004137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000748"/>
        <obo:IAO_0000115>iniB, an isoniazid-induced protein, is part of the iniBAC operon that participates in the development of tolerance to both isoniazid and ethambutol. May function through a MDR-pump like mechanism, although it does not appear to directly transport isoniazid from the cell.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004137</oboInOwl:id>
        <rdfs:label>Antibiotic resistant iniB</rdfs:label>
    </owl:Class>
    


