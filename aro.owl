    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004305"/>
        <obo:IAO_0000115>Any Pseudomonas aeruginosa that has tested resistant (R) to at least one of the following: amikacin, gentamicin, tobramycin.</obo:IAO_0000115>
