        <owl:annotatedTarget>Cefditoren is a semisynthetic cephalosporin active against staphylococci, streptococci, and and most enterobacteria. It is resistant to staphylococcal and most enterobacterial beta-lactamases, and is usually taken as the prodrug cefditoren pivoxil.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:7813385</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000650 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000650">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009107"/>
        <obo:IAO_0000115>Cefdinir is similar to cefixime with a modified side-chain at its 7-amino position. It also shares similar activity with cefixime but is more active against staphylococci. It has also be shown to enhance phagocytosis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:192314-93-5</oboInOwl:hasDbXref>
