        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000032"/>
        <obo:IAO_0000115>This subfamily includes other penem and cephalosporin antibiotics without defined classification by generation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009109</oboInOwl:id>
        <rdfs:label>other cephalosporins and penems</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009105"/>
        <obo:IAO_0000115>Cefazedone is a semisynthetic first-generation cephalosporin with antibacterial activity. Cefazedone binds to and inactivates penicillin-binding proteins (PBPs) located on the inner membrane of the bacterial cell wall.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:56187-47-4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:131731</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL2107636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:71736</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009110</oboInOwl:id>
        <rdfs:label>cefazedone</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009110"/>
