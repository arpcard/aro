        <oboInOwl:hasExactSynonym>Bleocin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bleomicin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bleomycin sulfate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Isobleomycin A2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cu-blenoxane</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000053</oboInOwl:id>
        <rdfs:label>bleomycin</rdfs:label>
    </owl:Class>
