        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000004"/>
        <obo:IAO_0000115>Subclass B1 possess a binuclear active site.  Within this active site can be either one or two Zn(II) ions.  This subclass is able to hydrolyze penicillins, cephalosporins and carbapenems.  This is the most clinically relevant subclass of MBLs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000568</oboInOwl:id>
        <rdfs:label>subclass B1 (metallo-) beta-lactamase</rdfs:label>
    </owl:Class>
