        <owl:annotatedTarget>vanI_cluster</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003723">
