    <!-- http://purl.obolibrary.org/obo/ARO_0000069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000050"/>
        <obo:IAO_0000115>Doxycycline is second generation semi-synthetic derivative of the tetracycline group of antibiotics. It inhibits bacterial protein synthesis by binding to the 30S subunit of the bacterial ribosome and preventing the aminotransferase-tRNA from associating with the ribosome.</obo:IAO_0000115>
