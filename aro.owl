            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Botrytis cinerea beta-tubulin with mutations associated with resistance against carbendazim.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009320</oboInOwl:id>
