    <!-- http://purl.obolibrary.org/obo/ARO_0000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000707"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007382"/>
        <obo:IAO_0000115>Gentamicin C is a mixture of gentamicin C1, gentamicin C1a, and gentamicin C2 (these differ in substituents at position C6&apos;). Gentamicin works by binding to the bacterial 30S ribosomal subunit, causing misreading of mRNA and leaving the bacterium unable to synthesize proteins vital to its growth.</obo:IAO_0000115>
