    <!-- http://purl.obolibrary.org/obo/ARO_3000112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000159"/>
        <obo:IAO_0000115>Directed pumping of antibiotic out of a cell to confer resistance. Multidrug and toxic compound extrusion (MATE) transporters utilize the cationic gradient across the membrane as an energy source. Although there is a diverse substrate specificity, almost all MATE transporters recognize fluoroquinolones. Arciflavine, ethidium and aminoglycosides are also good substrates.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000112</oboInOwl:id>
        <rdfs:label>multidrug and toxic compound extrusion (MATE) transporter</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Directed pumping of antibiotic out of a cell to confer resistance. Multidrug and toxic compound extrusion (MATE) transporters utilize the cationic gradient across the membrane as an energy source. Although there is a diverse substrate specificity, almost all MATE transporters recognize fluoroquinolones. Arciflavine, ethidium and aminoglycosides are also good substrates.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16330770</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:19100867</oboInOwl:hasDbXref>
    </owl:Axiom>
    


