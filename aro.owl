        <oboInOwl:hasExactSynonym>protionamide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004025</oboInOwl:id>
        <rdfs:label>prothionamide</rdfs:label>
    </owl:Class>
