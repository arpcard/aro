        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000017"/>
        <obo:IAO_0000115>Pirlimycin is an experimental/veterinary lincosamide antibiotic. Although not approved for use in humans, pirlimycin is commonly used to treat mammary gland infections in cattle.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CHEBI:201427</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL1652611</oboInOwl:hasDbXref>
