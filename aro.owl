    <!-- http://purl.obolibrary.org/obo/ARO_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
        <obo:IAO_0000115>Tobramycin is an aminoglycoside antibiotic used to treat different types of bacterial infections. Tobramycin works by binding to the bacterial 30S ribosomal subunit, causing misreading of mRNA and leaving the bacterium unable to synthesize proteins vital to its growth.</obo:IAO_0000115>
