    <!-- http://purl.obolibrary.org/obo/ARO_3007695 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000069"/>
        <obo:IAO_0000115>We identified ceftazidime/avibactam resistance in E. coli associated with a novel CMY variant. Unlike other AmpC enzymes, CMY-185 appears to require an additional substitution on top of N346Y to confer ceftazidime/avibactam resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CMY-185</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007695</oboInOwl:id>
        <rdfs:label>CMY-185</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007695"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
