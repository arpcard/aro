        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The P-site of the ribosome binds the peptidyl-tRNA with the growing polypeptide chain. Antibiotics that target the P-site block fMet-tRNA from entering, thus inhibiting peptide elongation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:15755955</oboInOwl:hasDbXref>
    </owl:Axiom>
    


