        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009656"/>
        <obo:IAO_0000115>Formicin is a two-component broad-spectrum lantibiotic produced by Bacillus paralicheniformis APC 1576, exhibiting antimicrobial activity against several Gram-positive species, including Staphylococcus aureus, Clostridioides difficile and Listeria monocytogenes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:50667-69-1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:192837</oboInOwl:hasDbXref>
