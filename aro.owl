        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000199"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Gramicidin D is a mixture of the linear peptides gramicidin A, B, and C, each with 15 alternating L- and D-amino acids. They are active against most gram-positive bacteria and select gram-negative bacteria. These compounds create channels in the bacterial membrane and increase the permeability to cations.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17572379</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:9672588</oboInOwl:hasDbXref>
