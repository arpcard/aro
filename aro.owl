    <!-- http://purl.obolibrary.org/obo/ARO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000042"/>
        <obo:IAO_0000115>Tigecycline is an glycylcycline antibiotic. It works by inhibiting action of the prokaryotic 30S ribosome.</obo:IAO_0000115>
