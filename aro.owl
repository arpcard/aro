    <!-- http://purl.obolibrary.org/obo/ARO_3007608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000709"/>
        <obo:IAO_0000115>ERG11 is a cytochrome P450 enzyme in Candida species that is not functional when bound by azole antibiotics including fluconazole and itraconazole. However, high levels of ERG11 expression can overcome effective azole doses.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007608</oboInOwl:id>
        <rdfs:label>antibiotic susceptible ERG11</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ERG11 is a cytochrome P450 enzyme in Candida species that is not functional when bound by azole antibiotics including fluconazole and itraconazole. However, high levels of ERG11 expression can overcome effective azole doses.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18487346</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:35163552</oboInOwl:hasDbXref>
    </owl:Axiom>
    


