        <oboInOwl:hasExactSynonym>Choliflavin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Euflavine</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Pantonsiletten</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Xanthacridinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000045</oboInOwl:id>
