        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009589</oboInOwl:id>
        <rdfs:label>Saccharomyces cerevisiae ERG11 lanosterol 14-alpha-demethylase with mutations conferring resistance to itraconazole</rdfs:label>
    </owl:Class>
    


