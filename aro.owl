    <!-- http://purl.obolibrary.org/obo/ARO_3009662 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>CARD:Epi denotes the natural-language-processing (NLP) module of the Comprehensive Antibiotic Resistance Database (CARD) that captures literature-derived associations between antibiotic resistance genes (ARGs) in CARD&apos;s Antibiotic Resistance Ontology (ARO) and normalized epidemiological terms drawn from external lexicons (SO, NCBI_TAXON, GAZ, IDO, UBERON, FOODON, ENV). Each association records the source lexicon, the normalized term&apos;s accession and name, and the number of supporting PubMed publications, with individual supporting citations (PMID and sentence-level location) tracked separately.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009662</oboInOwl:id>
        <rdfs:label>CARD:Epi</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009663 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>CARD:k-mers refers to the k-mer classification module of CARD that jointly predicts species-level pathogen taxonomy and genomic context (plasmid versus chromosome) for antimicrobial resistance genes (ARGs) detected in short metagenomic reads. It is the first CARD tool to unify ARG detection, host taxonomy, and genomic-context assignment in a single classifier, addressing a gap where general-purpose k-mer classifiers (e.g., Kraken2, CLARK) perform poorly on AMR-specific sequences.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CARD:k-mers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009663</oboInOwl:id>
        <rdfs:label>CARD k-mers</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009663"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>CARD:k-mers refers to the k-mer classification module of CARD that jointly predicts species-level pathogen taxonomy and genomic context (plasmid versus chromosome) for antimicrobial resistance genes (ARGs) detected in short metagenomic reads. It is the first CARD tool to unify ARG detection, host taxonomy, and genomic-context assignment in a single classifier, addressing a gap where general-purpose k-mer classifiers (e.g., Kraken2, CLARK) perform poorly on AMR-specific sequences.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1101/2025.09.15.676352v1</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009664 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>A robust, reliable, and frequently updated targeted bait capture method for metagenomic detection of antibiotic resistance determinants in complex samples. Synthesis and enrichment protocols, plus bait sequences are available for download at the Comprehensive Antibiotic Resistance Database.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009664</oboInOwl:id>
        <rdfs:label>CARD Bait Capture Platform</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009664"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A robust, reliable, and frequently updated targeted bait capture method for metagenomic detection of antibiotic resistance determinants in complex samples. Synthesis and enrichment protocols, plus bait sequences are available for download at the Comprehensive Antibiotic Resistance Database.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:40019273</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009665 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>RGI is the bioinformatic tool used to predict antimicrobial resistance genes (ARGs) and their associated resistance mechanisms from genomic or metagenomic sequence data by aligning input sequences against the curated reference sequences and detection models in the Comprehensive Antibiotic Resistance Database (CARD).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009665</oboInOwl:id>
        <rdfs:label>Resistance Gene Identifier</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009665"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>RGI is the bioinformatic tool used to predict antimicrobial resistance genes (ARGs) and their associated resistance mechanisms from genomic or metagenomic sequence data by aligning input sequences against the curated reference sequences and detection models in the Comprehensive Antibiotic Resistance Database (CARD).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:36263822</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>Computer-generated resistome predictions for 414 important pathogens at the Comprehensive Antibiotic Resistance Database. Includes sequence variants beyond those reported in the scientific literature, as well as prevalence statistics for AMR genes among pathogens, genomes, and plasmids.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CARD Resistomes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009666</oboInOwl:id>
        <rdfs:label>CARD-R</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Computer-generated resistome predictions for 414 important pathogens at the Comprehensive Antibiotic Resistance Database. Includes sequence variants beyond those reported in the scientific literature, as well as prevalence statistics for AMR genes among pathogens, genomes, and plasmids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:36263822</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009667 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>CARD*Shark is a machine-learning classification algorithm developed to automate literature curation triage for the Comprehensive Antibiotic Resistance Database (CARD). Trained on publications already contained in CARD, it downloads and processes newly indexed PubMed articles and identifies those likely describing first reports of novel antimicrobial resistance genes, flagging them for biocurator review.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009667</oboInOwl:id>
        <rdfs:label>CARD*Shark</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009667"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>CARD*Shark is a machine-learning classification algorithm developed to automate literature curation triage for the Comprehensive Antibiotic Resistance Database (CARD). Trained on publications already contained in CARD, it downloads and processes newly indexed PubMed articles and identifies those likely describing first reports of novel antimicrobial resistance genes, flagging them for biocurator review.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37079891</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1579"/>
        <obo:IAO_0000115>A respiratory system disease which involves the lower respiratory tract.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050161</oboInOwl:id>
        <rdfs:label>lower respiratory tract disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_11162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_850"/>
        <obo:IAO_0000115>A lung disease characterized by inadequate gas exchange by the respiratory system.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11162</oboInOwl:id>
        <rdfs:label>respiratory failure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_11394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11162"/>
        <obo:IAO_0000115>A respiratory failure that results from diffuse injury to the endothelium of the lung (as in sepsis, chest trauma, massive blood transfusion, aspiration of the gastric contents, or pneumonia) and is characterized by pulmonary edema with an abnormally high amount of protein in the edematous fluid and by difficult rapid breathing and hypoxemia.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11394</oboInOwl:id>
        <rdfs:label>adult respiratory distress sydrome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_12716 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11162"/>
        <obo:IAO_0000115>A respiratory failure that is characterized by deficiency of the surfactant coating the inner surface of the lungs, by failure of the lungs to expand and contract properly during breathing with resulting collapse, and by the accumulation of a protein-containing film lining the alveoli and their ducts.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12716</oboInOwl:id>
        <rdfs:label>newborn respiratory distress syndrome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004430"/>
        <obo:IAO_0000115>A cystitis characterized by a sudden onset or severe symptoms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13148</oboInOwl:id>
        <rdfs:label>acute cystitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_1579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004430"/>
        <obo:IAO_0000115>A disease of anatomical entity that located_in the respiratory system which extends from the nasal sinuses to the diaphragm.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1579</oboInOwl:id>
        <rdfs:label>respiratory system disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_37 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_37">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004430"/>
        <obo:IAO_0000115>An integumentary system disease that is located in the skin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:37</oboInOwl:id>
        <rdfs:label>skin disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050161"/>
        <obo:IAO_0000115>A lower respiratory tract disease in which the function of the lungs is adversely affected by narrowing or blockage of the airways resulting in poor air flow, a loss of elasticity in the lungs that produces a decrease in the total volume of air that the lungs are able to hold, and clotting, scarring, or inflammation of the blood vessels that affect the ability of the lungs to take up oxygen and to release carbon dioxide.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:850</oboInOwl:id>
        <rdfs:label>lung disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0031292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0031292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004430"/>
        <obo:IAO_0000115>A circumscribed area of pus or necrotic debris in the skin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>HP:0031292</oboInOwl:id>
        <rdfs:label>cutaneous abscess</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_23014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_23014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004389"/>
        <obo:IAO_0000115>Gram staining is a method for staining and identifying bacteria. It is based on the differential retention of a crystal violet-iodine complex within the cell membrane. The cell wall of gram-positive cells have a thick peptidoglycan layer that retains crystal violet after an alcohol wash (staining black-blue or purple by a counterstain). The cell wall of gram-negative cells have a thinner peptidoglycan layer that does not retain crystal violet after an alcohol wash (staining red after counterstain). Some cells have variable staining in culture (e.g. Bacillus, Clostridium) while others have indeterminate staining due to unique aspects of their cell membrane or wall (e.g. Mycobacterium, Mycoplasma).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>NCIT:23014</oboInOwl:id>
        <rdfs:label>gram stain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/NCIT_23014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Gram staining is a method for staining and identifying bacteria. It is based on the differential retention of a crystal violet-iodine complex within the cell membrane. The cell wall of gram-positive cells have a thick peptidoglycan layer that retains crystal violet after an alcohol wash (staining black-blue or purple by a counterstain). The cell wall of gram-negative cells have a thinner peptidoglycan layer that does not retain crystal violet after an alcohol wash (staining red after counterstain). Some cells have variable staining in culture (e.g. Bacillus, Clostridium) while others have indeterminate staining due to unique aspects of their cell membrane or wall (e.g. Mycobacterium, Mycoplasma).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19885931</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_85540 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_85540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000045"/>
        <obo:IAO_0000115>A method to determine whether microbial growth is affected by an antimicrobial compound.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>NCIT:85540</oboInOwl:id>
        <rdfs:label>microbial susceptibility test</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_85595 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_85595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004391"/>
        <obo:IAO_0000115>A method to determine microbial susceptibility to antibiotics wherein bacteria are inoculated onto agar plates and the antimicrobial agent diffused onto the agar plate from a filter paper disk. An approximate, but not exact, MIC is determined by the diameter of growth inhibition zones. This method has been found to have good correlation between in-vivo data and in-vitro data.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Kirby-Bauer disk assay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>NCIT:85595</oboInOwl:id>
        <rdfs:label>disk-diffusion method</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/NCIT_85595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method to determine microbial susceptibility to antibiotics wherein bacteria are inoculated onto agar plates and the antimicrobial agent diffused onto the agar plate from a filter paper disk. An approximate, but not exact, MIC is determined by the diameter of growth inhibition zones. This method has been found to have good correlation between in-vivo data and in-vitro data.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29403965</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_85596 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_85596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004391"/>
        <obo:IAO_0000115>A method to determine microbial susceptibility to antibiotics in which a plastic strip impregnated with the antibiotic of interest is placed on an agar plate that has been inoculated with bacteria. The antibiotic diffuses from the strip producing a concentration gradient of drug on the agar. The point at which the elliptical shaped area of growth inhibition meets the strip is the minimum inhibitory concentration of the drug of interest.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>NCIT:85596</oboInOwl:id>
        <rdfs:label>antimicrobial gradient method (E-test)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/NCIT_85596"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method to determine microbial susceptibility to antibiotics in which a plastic strip impregnated with the antibiotic of interest is placed on an agar plate that has been inoculated with bacteria. The antibiotic diffuses from the strip producing a concentration gradient of drug on the agar. The point at which the elliptical shaped area of growth inhibition meets the strip is the minimum inhibitory concentration of the drug of interest.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29403965</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/NCIT_85701 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_85701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004397"/>
        <obo:IAO_0000115>A method to determine the minimum inhibitory concentration (MIC) of antibiotics in which growth media is pipetted into a multi-well plate. Each well contains a known concentration of drug which is inoculated with a known quantity of bacteria. The plate is incubated for a specified period of time and each well is assessed for bacterial cell growth. The drug concentration in the first well showing no growth is known as the MIC for that antibiotic. Minimum 2 mL total broth dilution volume.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>NCIT:85701</oboInOwl:id>
        <rdfs:label>macro broth dilution method</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/NCIT_85701"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method to determine the minimum inhibitory concentration (MIC) of antibiotics in which growth media is pipetted into a multi-well plate. Each well contains a known concentration of drug which is inoculated with a known quantity of bacteria. The plate is incubated for a specified period of time and each well is assessed for bacterial cell growth. The drug concentration in the first well showing no growth is known as the MIC for that antibiotic. Minimum 2 mL total broth dilution volume.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29403965</oboInOwl:hasDbXref>
    </owl:Axiom>
    


