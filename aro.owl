        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>PBT2 is a former Alzheimer&apos;s and Huntington&apos;s disease candidate drug that has since been shown to increase susceptibility to colistin, polymyxin B, and tetracycline in N. gonorrhoeae. It is thought to inactivate lipooligosaccharide phosphoethanolamine transferase A, resulting in alteration of cell membrane charge.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:34450628</oboInOwl:hasDbXref>
    </owl:Axiom>
    


