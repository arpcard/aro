    <!-- http://purl.obolibrary.org/obo/ARO_3007434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003580"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007428"/>
