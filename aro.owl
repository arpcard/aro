            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A grouping of tunicamycin resistance proteins that are homologous to tmrB found in Bacillus subtilis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004285</oboInOwl:id>
