        <oboInOwl:hasDbXref>PubChem:59364992</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007761</oboInOwl:id>
        <rdfs:label>gamithromycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007761"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Gamithromycin, a novel semi-synthetic macrolide, is approved for the treatment and prevention of bovine respiratory disease. It plays a bacteriostatic and bactericidal role by inhibiting the ribosomal 50S subunit.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31680940</oboInOwl:hasDbXref>
