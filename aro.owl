    <!-- http://purl.obolibrary.org/obo/ARO_3001249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3001310"/>
        <obo:IAO_0000115>Phenelfamycin A was isolated from two environmental isolates called AB999F-80 and AB1047T-33. They were both identified as Streptomyces violaceoniger strains. Both these strains were found to produce phenelfamycins A-F and unphenelfamycin. Phenelfamycin A has a monosaccaride moeity and is isomeric with phenelfamycin B. All phenelfamycins were selected due to their activity against anaerobic bacteria, especially Clostridioides difficile.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CHEBI:222054</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:6443943</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3001249</oboInOwl:id>
        <rdfs:label>phenelfamycin A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3001249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Phenelfamycin A was isolated from two environmental isolates called AB999F-80 and AB1047T-33. They were both identified as Streptomyces violaceoniger strains. Both these strains were found to produce phenelfamycins A-F and unphenelfamycin. Phenelfamycin A has a monosaccaride moeity and is isomeric with phenelfamycin B. All phenelfamycins were selected due to their activity against anaerobic bacteria, especially Clostridioides difficile.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:2921230</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:3192489</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:3192490</oboInOwl:hasDbXref>
