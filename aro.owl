    <!-- http://purl.obolibrary.org/obo/ARO_0000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009107"/>
        <obo:IAO_0000115>Ceftriaxone is a third-generation cephalosporin antibiotic. The presence of an aminothiazolyl sidechain increases ceftriazone&apos;s resistance to beta-lactamases. Like other third-generation cephalosporins, it has broad spectrum activity against Gram-positive and Gram-negative bacteria.</obo:IAO_0000115>
