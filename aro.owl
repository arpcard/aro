    <!-- http://purl.obolibrary.org/obo/ARO_3001257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3001310"/>
        <obo:IAO_0000115>Unphenelfamycin was isolated from two environmental isolates called AB999F-80 and AB1047T-33. They were both identified as Streptomyces violaceoniger strains. Both these strains were found to produce phenelfamycins A-F and unphenelfamycin. Unphenelfamycin has a monosaccaride moeity and lacks the  phenacetyl moeity present in the other phenelfamycins. All phenelfamycins were selected due to their activity against anaerobic bacteria, especially Clostridioides difficile.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CHEBI:222022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:6443942</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
