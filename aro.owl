            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>GadW is an AraC-family regulator that promotes mdtEF expression to confer multidrug resistance. GadW inhibits GadX-dependent activation. GadW clearly represses gadX and, in situations where GadX is missing, activates gadA and gadBC.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>YhiW</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gadW</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003838</oboInOwl:id>
        <rdfs:label>gadW</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003838"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>GadW is an AraC-family regulator that promotes mdtEF expression to confer multidrug resistance. GadW inhibits GadX-dependent activation. GadW clearly represses gadX and, in situations where GadX is missing, activates gadA and gadBC.</owl:annotatedTarget>
