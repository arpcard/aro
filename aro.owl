    <!-- http://purl.obolibrary.org/obo/ARO_3003324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000863"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000693"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MprF is a integral membrane protein that modifies the negatively-charged phosphatidylglycerol on the membrane surface. This confers resistance to cationic peptides that disrupt the cell membrane, including defensins. Additionally, large-scale mutations causing loss of function of the gene result in increased susceptibility to daptomycin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Bsub_mprF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003324</oboInOwl:id>
        <rdfs:label>Bacillus subtilis mprF</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>MprF is a integral membrane protein that modifies the negatively-charged phosphatidylglycerol on the membrane surface. This confers resistance to cationic peptides that disrupt the cell membrane, including defensins. Additionally, large-scale mutations causing loss of function of the gene result in increased susceptibility to daptomycin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19164152</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:19915718</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:21709092</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003324"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Bsub_mprF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


