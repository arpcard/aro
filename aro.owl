        <oboInOwl:hasExactSynonym>Nizonide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>nitazoxamide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007178</oboInOwl:id>
        <rdfs:label>nitazoxanide</rdfs:label>
    </owl:Class>
    <owl:Axiom>
