    <!-- http://purl.obolibrary.org/obo/ARO_3002417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3002417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000078"/>
