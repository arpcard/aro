    <!-- http://purl.obolibrary.org/obo/ARO_3009337 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003938"/>
