                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009314"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Glucan synthase FKS2 is involved in the production of the fungal cell wall by the synthesis of the core component beta-1,3-glucan in Candida spp. Mutations in FKS2 have been shown to confer resistance to echinocandin antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Nakaseomyces glabratus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009207</oboInOwl:id>
        <rdfs:label>Candida glabrata FKS2 with mutations conferring resistance to anidulafungin</rdfs:label>
    </owl:Class>
