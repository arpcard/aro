        <oboInOwl:hasDbXref>PubChem:6196</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>MPI-penicillin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ossacillina</oboInOwl:hasExactSynonym>
