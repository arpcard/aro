    <!-- http://purl.obolibrary.org/obo/ARO_3007706 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007706">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>OXA-213-like enzymes have been identified to be intrinsic to A. calcoaceticus and have been subsequently detected in A. pittii. Phylogenetic analysis of OXA-213-like proteins identified two distinct subgroups within the OXA family. The first group was linked to A. pittii and the second group to A. calcoaceticus. The carbapenemase activity of these OXAs may be related to the species-dependent effect.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007706</oboInOwl:id>
        <rdfs:label>OXA-213-like beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007706"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OXA-213-like enzymes have been identified to be intrinsic to A. calcoaceticus and have been subsequently detected in A. pittii. Phylogenetic analysis of OXA-213-like proteins identified two distinct subgroups within the OXA family. The first group was linked to A. pittii and the second group to A. calcoaceticus. The carbapenemase activity of these OXAs may be related to the species-dependent effect.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:24696435</oboInOwl:hasDbXref>
    </owl:Axiom>
    


