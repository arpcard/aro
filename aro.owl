        <oboInOwl:hasExactSynonym>CIP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Cipro</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ciprobay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ciproxan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
