        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009279</oboInOwl:id>
        <rdfs:label>Colletotrichum siamense cytochrome b protein with mutations associated with resistance to azoxystrobin</rdfs:label>
    </owl:Class>
    


