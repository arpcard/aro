                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000765"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>embB gene encodes for an arabinosyl transferase in the arabinogalactan synthesis pathway. It is inhibited by ethambutol. Mutations within the ERDR region of embB confers resistance to ethambutol.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000235</oboInOwl:id>
        <rdfs:label>ethambutol resistant embB</rdfs:label>
    </owl:Class>
    <owl:Axiom>
