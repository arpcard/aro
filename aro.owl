    <!-- http://purl.obolibrary.org/obo/ARO_3000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009657"/>
        <obo:IAO_0000115>Edeines are basic linear peptides produced by Bacillus brevis Vm4. They have antibacterial as well as antifungal, antiviral, and anticancer properties. Edeines are bacteriostatic and bacteriocidal at low and high concentrations, respectively. They are able to inhibit DNA synthesis and protein translation. These compounds are synthesized by nonribosomal peptide synthetases and contain numerous unusual amino acids.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000119</oboInOwl:id>
        <rdfs:label>edeine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000119"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Edeines are basic linear peptides produced by Bacillus brevis Vm4. They have antibacterial as well as antifungal, antiviral, and anticancer properties. Edeines are bacteriostatic and bacteriocidal at low and high concentrations, respectively. They are able to inhibit DNA synthesis and protein translation. These compounds are synthesized by nonribosomal peptide synthetases and contain numerous unusual amino acids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:70202</oboInOwl:hasDbXref>
    </owl:Axiom>
    


