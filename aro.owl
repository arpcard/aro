    <!-- http://purl.obolibrary.org/obo/ARO_3000659 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115>Gatifloxacin is an 8-methoxy, 7-piperazinyl, 6-fluoroquinolone that can be taken orally or by intravenous administration. It is active against most Gram-positive and Gram-negative bacteria, but inactive against non-fermenting Gram-negative rods including Pseudomonas aeruginosa.</obo:IAO_0000115>
