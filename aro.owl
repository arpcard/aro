        <oboInOwl:hasDbXref>PMID:26969433</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009319"/>
        <rdfs:subClassOf>
