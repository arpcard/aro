            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The P-site of the ribosome binds the peptidyl-tRNA with the growing polypeptide chain. Antibiotics that target the P-site block fMet-tRNA from entering, thus inhibiting peptide elongation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000756</oboInOwl:id>
        <rdfs:label>30S ribosomal subunit P-site</rdfs:label>
    </owl:Class>
