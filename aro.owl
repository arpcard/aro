    <!-- http://purl.obolibrary.org/obo/ARO_3000664 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000664">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115>Trovafloxacin is a trifluoroquinalone with a broad spectrum of activity that acts by inhibiting the uncoiling of supercoiled DNA. While potent against many Gram-positive and Gram-negative bacteria, it is less active against pseudomonads and Cl. difficile. It is usually taken as the prodrug trovafloxacin mesylate or alatrofloxacin mesylate for oral or intravenous administration, respectively.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:147059-72-1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:9763</oboInOwl:hasDbXref>
