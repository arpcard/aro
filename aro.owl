        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115>Increased expression of an antibiotic target protein can overcome effective dose of an antibiotic, leading to reduced susceptibility.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007609</oboInOwl:id>
