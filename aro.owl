    <!-- http://purl.obolibrary.org/obo/ARO_0000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000020"/>
        <obo:IAO_0000115>Meropenem is an ultra-broad spectrum injectable antibiotic used to treat a wide variety of infections, including meningitis and pneumonia. It is a beta-lactam and belongs to the subgroup of carbapenem, similar to imipenem and ertapenem.</obo:IAO_0000115>
