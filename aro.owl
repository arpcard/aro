    <!-- http://purl.obolibrary.org/obo/ARO_3009392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <rdfs:subClassOf>
