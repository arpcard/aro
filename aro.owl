        <obo:IAO_0000115>Precursor molecule during the synthesis of bacterial cell wall. Lipid II anchors itself onto the cell and it&apos;s disaccharide-peptide subunit is used in PG polymer assembly by peptidoglycan glycosyltransferases. Due to it&apos;s importance in cell wall synthesis, it is the target of antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003231</oboInOwl:id>
        <rdfs:label>Lipid II</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003231"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Precursor molecule during the synthesis of bacterial cell wall. Lipid II anchors itself onto the cell and it&apos;s disaccharide-peptide subunit is used in PG polymer assembly by peptidoglycan glycosyltransferases. Due to it&apos;s importance in cell wall synthesis, it is the target of antibiotics.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25291014</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003232 -->

