                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000584"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MsrA is an ABC-F subfamily ribosomal protection protein expressed in Staphylococcus species which confers resistance to erythromycin and streptogramin B antibiotics through antibiotic target protection mechanisms. It is associated with plasmid DNA.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>msr(A)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>msrA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000251</oboInOwl:id>
        <rdfs:label>msrA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000251"/>
