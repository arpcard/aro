                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000057"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Mel, a homolog of MsrA, is an ABC-F subfamily protein associated with macrolide resistance. It is expressed on the same operon as mefA and mefE, both MFS-type efflux proteins that confer macrolide resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mefA</oboInOwl:hasExactSynonym>
