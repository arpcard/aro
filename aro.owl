    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004875 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003417"/>
