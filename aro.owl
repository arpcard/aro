            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Ribosomal RNA (rRNA) methyltransferases are a functional class of enzymes which catalyze the addition of S-adenosylmethionine to specific nucleotide bases in ribosomal RNA. The addition of a methyl group at select positions is associated with antibiotic resistance via antibiotic target protection.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000164</oboInOwl:id>
        <rdfs:label>Ribosomal RNA methyltransferase conferring antibiotic resistance</rdfs:label>
    </owl:Class>
