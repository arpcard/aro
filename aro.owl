    <!-- http://purl.obolibrary.org/obo/ARO_3000787 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000111"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MdtABC-TolC is a multidrug efflux system in Gram-negative bacteria, including E. coli and Salmonella. MdtA is a membrane fusion protein; TolC is the outer membrane channel; MdtBC form a drug transporter. In the absence of MdtB, the MdtAC-TolC has narrower drug specificity, leading to the loss of novobiocin resistance, for example.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MdtABC-TolC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000787</oboInOwl:id>
        <rdfs:label>MdtABC-TolC</rdfs:label>
    </owl:Class>
