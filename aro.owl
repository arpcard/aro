        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004388"/>
        <obo:IAO_0000115>A method to determine microbial susceptibility to antibiotics in which test bacteria is inoculated onto an agar plate that contains a concentration gradient of antibiotic. The minimum inhibitory concentration of antibiotic is assessed.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004723</oboInOwl:id>
