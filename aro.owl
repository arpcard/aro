        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>This compound is used to control a number of cereal fungal pathogens including those belonging to the Ascomycetes, Basidiomycetes and Zygomycetes families.</owl:annotatedTarget>
