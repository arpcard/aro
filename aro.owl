    <!-- http://purl.obolibrary.org/obo/ARO_3000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000040"/>
        <obo:IAO_0000115>Mechanism of enzymatic degradation common to Ambler Class B beta-lactamases. One or two zinc atoms are used to orient a hydroxide nucleophile for attack of the beta-lactam ring.  In contrast to serine beta-lactamases, no acyl-enzyme intermediate is formed.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000203</oboInOwl:id>
        <rdfs:label>hydrolysis of beta-lactam antibiotic by metallo-beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mechanism of enzymatic degradation common to Ambler Class B beta-lactamases. One or two zinc atoms are used to orient a hydroxide nucleophile for attack of the beta-lactam ring.  In contrast to serine beta-lactamases, no acyl-enzyme intermediate is formed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:20564281</oboInOwl:hasDbXref>
    </owl:Axiom>
    


