            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The AMZ genes showed resistance against some beta-lactam antibiotics, including amoxicillin and cephalothin, and the beta-lactamase AMZ-1 exhibited a similar substrate spectrum response. Similar to other AmpC beta-lactamases, AMZ-1 is strongly inhibited by avibactam but much less strongly inhibited by tazobactam.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007693</oboInOwl:id>
        <rdfs:label>AMZ beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007693"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The AMZ genes showed resistance against some beta-lactam antibiotics, including amoxicillin and cephalothin, and the beta-lactamase AMZ-1 exhibited a similar substrate spectrum response. Similar to other AmpC beta-lactamases, AMZ-1 is strongly inhibited by avibactam but much less strongly inhibited by tazobactam.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37808287</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007694 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007694">
