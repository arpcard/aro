    <!-- http://purl.obolibrary.org/obo/ARO_3000695 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000695">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009657"/>
        <obo:IAO_0000115>Actinomycins are peptide antibiotics that interact with DNA. This prevents RNA synthesis, thus preventing the production of proteins vital to the cell.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000695</oboInOwl:id>
