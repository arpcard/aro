            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Catalyzes the addition of a thiol group from a nucleophilic molecule to fosfomycin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000133</oboInOwl:id>
