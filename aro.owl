                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Loss-of-function mutations in Rv2535c (pepQ) in Mycobacterium and Mycobacteroides which are associated with resistance to clofazimine.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009334</oboInOwl:id>
        <rdfs:label>clofazimine resistant Rv2535c</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009335 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009334"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>These pepQ/Rv2535c mutations increase efflux through the mmpL5-mmpS5 (Rv0676c-Rv0677c) transporter, such as preventing degradation of MmpL5, which leads to reduced susceptibility to bedaquiline and clofazimine.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mtub_pepQ_CFZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009335</oboInOwl:id>
        <rdfs:label>Mycobacterium tuberculosis Rv2535c with mutation conferring resistance to clofazimine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009335"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>These pepQ/Rv2535c mutations increase efflux through the mmpL5-mmpS5 (Rv0676c-Rv0677c) transporter, such as preventing degradation of MmpL5, which leads to reduced susceptibility to bedaquiline and clofazimine.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:978-92-4-008241-0</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
