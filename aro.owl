        <oboInOwl:id>ARO:3004327</oboInOwl:id>
        <rdfs:label>aminoglycoside-resistant Pseudomonas aeruginosa</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004328 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004328">
