    <!-- http://purl.obolibrary.org/obo/ARO_3004056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009640"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002407"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>ArmR, a 53-amino-acid antirepressor, allosterically inhibits MexR dimer-DNA binding by occupying a hydrophobic binding cavity within the center of the MexR dimer. ArmR up-regulation and MexR-ArmR complex formation have previously been shown to upregulate MexAB-OprM.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>ArmR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004056</oboInOwl:id>
        <rdfs:label>ArmR</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ArmR, a 53-amino-acid antirepressor, allosterically inhibits MexR dimer-DNA binding by occupying a hydrophobic binding cavity within the center of the MexR dimer. ArmR up-regulation and MexR-ArmR complex formation have previously been shown to upregulate MexAB-OprM.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17545281</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:18812515</oboInOwl:hasDbXref>
    </owl:Axiom>
