        <oboInOwl:hasExactSynonym>Oxacilline</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oxacillinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oxazocillin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Oxazocilline</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Prostaphlin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Prostaphlyn</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000056</oboInOwl:id>
        <rdfs:label>oxacillin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_0000056"/>
