    <!-- http://purl.obolibrary.org/obo/ARO_3000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007380"/>
        <rdfs:subClassOf>
            <owl:Restriction>
