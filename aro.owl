                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004491"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Loss-of-function mutations in Rv2535c (pepQ) in Mycobacterium and Mycobacteroides which are associated with resistance to bedaquiline.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
