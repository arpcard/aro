            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Nucleotide point mutations in the 50S rRNA subunit (not in the 23s rRNA range) may confer resistance to macrolide antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3005001</oboInOwl:id>
        <rdfs:label>50S rRNA with mutation conferring resistance to macrolide antibiotics</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3005002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3005002">
