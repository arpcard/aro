                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The mutations to this gene are involved in altering the translation elongation factor G (EF-G) in association with the ribosome to prevent fusidic acid from binding EF-G and preventing translation.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Saur_fusA_FA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
