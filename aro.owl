    <!-- http://purl.obolibrary.org/obo/ARO_3000831 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000831">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000750"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000524"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002211"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>CpxR is a regulator that promotes acrD expression when phosphorylated by a cascade involving CpxA, a sensor kinase. CpxR is also directly involved in activation of expression of RND efflux pump MexAB-OprM in P. aeruginosa. CpxR is required to enhance mexAB-oprM expression and drug resistance, in the absence of repressor MexR.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000831</oboInOwl:id>
        <rdfs:label>CpxR</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>CpxR is a regulator that promotes acrD expression when phosphorylated by a cascade involving CpxA, a sensor kinase. CpxR is also directly involved in activation of expression of RND efflux pump MexAB-OprM in P. aeruginosa. CpxR is required to enhance mexAB-oprM expression and drug resistance, in the absence of repressor MexR.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22496764</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:25294881</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:27736975</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000832 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000832">
