    <!-- http://purl.obolibrary.org/obo/ARO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009106"/>
        <obo:IAO_0000115>Cefoxitin is a cephamycin antibiotic often grouped with the second generation cephalosporins. Cefoxitin is bactericidal and acts by inhibiting the synthesis of the peptidoglycan layer of bacterial cell walls. The peptidoglycan layer is important for cell wall structural integrity, especially in Gram-positive organisms. Cefoxitin&apos;s 7-alpha-methoxy group and 3&apos; leaving group make it a poor substrate for most beta-lactamases.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:35607-66-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:209807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL996</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:441199</oboInOwl:hasDbXref>
