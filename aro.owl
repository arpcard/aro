    <!-- http://purl.obolibrary.org/obo/ARO_3000385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000387"/>
        <obo:IAO_0000115>Chloramphenicol is a bacteriostatic antimicrobial originally derived from the bacterium Streptomyces venezuelae. It was the first antibiotic to be manufactured synthetically on a large scale. It functions by inhibiting peptidyl transferase activity of the bacterial ribosome, binding to A2451 and A2452 residues in the 23S rRNA of the 50S ribosomal subunit and preventing peptide bond formation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:56-75-7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:17698</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:5959</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CHL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000385</oboInOwl:id>
        <rdfs:label>chloramphenicol</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000385"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Chloramphenicol is a bacteriostatic antimicrobial originally derived from the bacterium Streptomyces venezuelae. It was the first antibiotic to be manufactured synthetically on a large scale. It functions by inhibiting peptidyl transferase activity of the bacterial ribosome, binding to A2451 and A2452 residues in the 23S rRNA of the 50S ribosomal subunit and preventing peptide bond formation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17737966</oboInOwl:hasDbXref>
    </owl:Axiom>
    


