    <!-- http://purl.obolibrary.org/obo/ARO_3000324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000282"/>
        <obo:IAO_0000115>Sulfadiazine is a potent inhibitor of dihydropteroate synthase, interfering with the tetrahydrofolic biosynthesis pathway. Tetrahydrofolic acid is essential for folate synthesis, a precursor to many nucleotides and amino acids.</obo:IAO_0000115>
