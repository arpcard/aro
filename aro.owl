    <!-- http://purl.obolibrary.org/obo/ARO_0000071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115>Levofloxacin is a synthetic chemotherapeutic antibiotic of the fluoroquinolone drug class. Its main target is topoisomerase IV, inhibiting its function and disrupting DNA replication.</obo:IAO_0000115>
