    <!-- http://purl.obolibrary.org/obo/ARO_3003475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000716"/>
