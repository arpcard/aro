                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Hp1165 is a homolog of the Clostridium perfringes tetP gene and is part of the MFS efflux family but is not considered a true tetracycline resistance gene. Hp1165 confers low level resistance to tetracycline, however cessation of antibiotic treatment results in the host cell reverting to susceptibility.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007061</oboInOwl:id>
        <rdfs:label>hp1165</rdfs:label>
    </owl:Class>
