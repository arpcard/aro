                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Gramicidin D is a mixture of the linear peptides gramicidin A, B, and C, each with 15 alternating L- and D-amino acids. They are active against most gram-positive bacteria and select gram-negative bacteria. These compounds create channels in the bacterial membrane and increase the permeability to cations.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PubChem:45267103</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
