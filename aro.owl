    <!-- http://purl.obolibrary.org/obo/ARO_3000606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004211"/>
        <obo:IAO_0000115>FEZ-1 is an Ambler class B MBL; subclass B3 first isolated from Legionella gormanii.  It has activity against a broad range of beta-lactams and is only active with two Zn(II) ions in the active site.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>FEZ-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
