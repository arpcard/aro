            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Antibiotic target replacement dihydrofolate reductase enzymes or domains with catalytic activity that confer resistance to aminosalicylates, esp. p-aminosalicylic acid.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004183</oboInOwl:id>
