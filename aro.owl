        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003289</oboInOwl:id>
        <rdfs:label>antibiotic resistant rpoC</rdfs:label>
    </owl:Class>
    


