    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007223"/>
        <obo:IAO_0000115>PBT2 is a former Alzheimer&apos;s and Huntington&apos;s disease candidate drug that has since been shown to increase susceptibility to colistin, polymyxin B, and tetracycline in N. gonorrhoeae. It is thought to inactivate lipooligosaccharide phosphoethanolamine transferase A, resulting in alteration of cell membrane charge.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PubChem:10016012</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007144</oboInOwl:id>
        <rdfs:label>PBT2</rdfs:label>
    </owl:Class>
