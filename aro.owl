                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000760"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Alanine racemase (alr) converts the natural L-alanine to the D-alanine required in the pentapeptide chains in peptidoglycan. It is found in both Gram-positive and Gram-negative bacteria.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000722</oboInOwl:id>
        <rdfs:label>cycloserine sensitive alr</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000722"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Alanine racemase (alr) converts the natural L-alanine to the D-alanine required in the pentapeptide chains in peptidoglycan. It is found in both Gram-positive and Gram-negative bacteria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19748470</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:4555420</oboInOwl:hasDbXref>
    </owl:Axiom>
    


