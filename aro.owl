    <!-- http://purl.obolibrary.org/obo/ARO_3003821 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003821">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000004"/>
        <obo:IAO_0000115>BAL30072 is a monocyclic beta-lactam antibiotic belonging to the sulfactams. BAL30072 was found to trigger the spheroplasting and lysis of Escherichia coli rather than the formation of extensive filaments.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL1256967</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:52942440</oboInOwl:hasDbXref>
