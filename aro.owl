        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000076"/>
        <obo:IAO_0000115>A class of antibiotic adjuvants which indirectly improve antibiotic susceptibility or retention through alterations to host physiology or metabolism.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007226</oboInOwl:id>
