        <owl:annotatedTarget>Mutations in MRPL11 has shown conferred resistance to the echinocandin caspofungin.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:40790106</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009373 -->

