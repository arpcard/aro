    <!-- http://purl.obolibrary.org/obo/ARO_0001001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0001001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115>Mutational alteration or enzymatic modification of antibiotic target which results in antibiotic resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0001001</oboInOwl:id>
        <rdfs:label>antibiotic target alteration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_0001002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0001002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115>Replacement or substitution of antibiotic action target, which process will result in antibiotic resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>antibiotic target substitution</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0001002</oboInOwl:id>
        <rdfs:label>antibiotic target replacement</rdfs:label>
    </owl:Class>
    


