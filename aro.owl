    <!-- http://purl.obolibrary.org/obo/ARO_0000072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000079"/>
        <obo:IAO_0000115>Linezolid is a synthetic antibiotic used for the treatment of serious infections caused by Gram-positive bacteria that are resistant to several other antibiotics. It inhibits protein synthesis by binding to domain V of the 23S rRNA of the 50S subunit of bacterial ribosomes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:165800-03-3</oboInOwl:hasDbXref>
