                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007512"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007518"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MDR1 is a transporter belonging to the MFS class in fungi, often regulated by the MRR transcription factor.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009425</oboInOwl:id>
        <rdfs:label>fungal MDR</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009621"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007517"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009313"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The fungal Erg11 enzyme is lanosterol demethylase belongs to the broader P450 family. The enzyme contributes directly to ergosterol synthesis pathway. Azoles target lanosterol demethylase thereby halting ergosterol production and ultimately compromises fungal cell membrane integrity. Mutations to Erg11 genes have been shown to inhibit azole activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009426</oboInOwl:id>
        <rdfs:label>Candida albicans ERG11 with mutations conferring resistance to ketoconazole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009563"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007507"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002213"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009425"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002213"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009440"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002213"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009441"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In fungi, the Tac1 gene is a zinc cluster transcription factor that influences the transcription of several proteins related to antifungal resistance. Tac1 influences the expression of CDR1 and CDR2 which are multi-drug efflux transporters. Mutations to Tac1 can result in resistance against azole drugs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009427</oboInOwl:id>
        <rdfs:label>Candida albicans TAC1 with mutations conferring resistance to terbinafine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009298"/>
