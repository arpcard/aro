        <owl:annotatedTarget>Loss-of-function mutations in Rv2535c (pepQ) in Mycobacterium and Mycobacteroides which are associated with resistance to bedaquiline.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:27185800</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007692 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007692">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007691"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004492"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>These pepQ/Rv2535c mutations increase efflux through the mmpL5-mmpS5 (Rv0676c-Rv0677c) transporter, such as preventing degradation of MmpL5, which leads to reduced susceptibility to bedaquiline and clofazimine.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mtub_Rv2535_BDQ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rv2535c</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pepQ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007692</oboInOwl:id>
        <rdfs:label>Mycobacterium tuberculosis Rv2535c with mutation conferring resistance to bedaquiline</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007692"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>These pepQ/Rv2535c mutations increase efflux through the mmpL5-mmpS5 (Rv0676c-Rv0677c) transporter, such as preventing degradation of MmpL5, which leads to reduced susceptibility to bedaquiline and clofazimine.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:978-92-4-008241-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:27185800</oboInOwl:hasDbXref>
