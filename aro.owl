            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>FusB encodes a 2-domain zinc-binding protein that binds the ribosomal translocase EF-G, causing it to dissociate from the ribosome. This action increases the ribosomal turnover rate and confers resistance to fusidic acid. This protein is considered a FusB-type protein.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>fusB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003552</oboInOwl:id>
        <rdfs:label>fusB</rdfs:label>
    </owl:Class>
