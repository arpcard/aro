    <!-- http://purl.obolibrary.org/obo/ARO_3007172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007136"/>
