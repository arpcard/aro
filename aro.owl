        <rdfs:label>myclobutanil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009553"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Myclobutanil is a nitrile, a member of triazoles and a member of monochlorobenzenes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:33080784</oboInOwl:hasDbXref>
