        <oboInOwl:hasExactSynonym>Garamycin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gentacycol</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gentamicins</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Gentamycinum</oboInOwl:hasExactSynonym>
