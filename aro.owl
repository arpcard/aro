    <!-- http://purl.obolibrary.org/obo/ARO_3007061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010002"/>
