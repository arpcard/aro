    <!-- http://purl.obolibrary.org/obo/ARO_3003202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003201"/>
        <obo:IAO_0000115>TLA-1 is a beta-lactamase found in plasmids of clinical isolates of Escherichia coli strain R170 in Latin America. It preferentially hydrolyzed cephaloridine, cefotaxime, cephalothin, benzylpenicillin, and ceftazidime. The enzyme was markedly inhibited by sulbactam, tazobactam, and clavulanic acid.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>TLA-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003202</oboInOwl:id>
        <rdfs:label>TLA-1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>TLA-1 is a beta-lactamase found in plasmids of clinical isolates of Escherichia coli strain R170 in Latin America. It preferentially hydrolyzed cephaloridine, cefotaxime, cephalothin, benzylpenicillin, and ceftazidime. The enzyme was markedly inhibited by sulbactam, tazobactam, and clavulanic acid.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:15095209</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
