    <!-- http://purl.obolibrary.org/obo/ARO_3003446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000748"/>
        <obo:IAO_0000115>iniA, an isoniazid-induced protein, is part of the iniBAC operon that participates in the development of tolerance to both isoniazid and ethambutol. May function through a MDR-pump like mechanism, although it does not appear to directly transport isoniazid from the cell.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003446</oboInOwl:id>
        <rdfs:label>antibiotic resistant iniA</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003446"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>iniA, an isoniazid-induced protein, is part of the iniBAC operon that participates in the development of tolerance to both isoniazid and ethambutol. May function through a MDR-pump like mechanism, although it does not appear to directly transport isoniazid from the cell.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:15752203</oboInOwl:hasDbXref>
    </owl:Axiom>
    


