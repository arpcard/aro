    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000551"/>
        <obo:IAO_0000115>Arsinothricin is a natural product synthesized by the rhizosphere bacterium Burkholderia gladioli GSRB05 and is a broad-spectrum antibiotic effective against human pathogens such as carbapenem-resistant Enterobacter cloacae. It is a non-proteogenic amino acid and glutamate mimetic that inhibits bacterial glutamine synthetase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CHEBI:220158</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:170988177</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007534</oboInOwl:id>
        <rdfs:label>arsinothricin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007534"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Arsinothricin is a natural product synthesized by the rhizosphere bacterium Burkholderia gladioli GSRB05 and is a broad-spectrum antibiotic effective against human pathogens such as carbapenem-resistant Enterobacter cloacae. It is a non-proteogenic amino acid and glutamate mimetic that inhibits bacterial glutamine synthetase.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:36785875</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007535">
