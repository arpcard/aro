    <!-- http://purl.obolibrary.org/obo/ARO_3000616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004471"/>
