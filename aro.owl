                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007434"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>almE is a glycyltransferase found in Vibrio cholerae that transfers glycine to the carrier protein almF. almE is part of the almEFG polymyxin resistance operon.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>almE</oboInOwl:hasExactSynonym>
