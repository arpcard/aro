    <!-- http://purl.obolibrary.org/obo/ARO_3007010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002211"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000391"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>NorC is a multidrug efflux pump in Staphylococcus aureus that confers resistance to fluoroquinolones and other structurally unrelated antibiotics like tetracycline. It shares 61% similarity with NorB, and is a structural homolog of Blt of Bacillus subtilis. Like NorA and NorB, NorC is regulated by mgrA, also known as NorR.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>norC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007010</oboInOwl:id>
        <rdfs:label>norC</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>NorC is a multidrug efflux pump in Staphylococcus aureus that confers resistance to fluoroquinolones and other structurally unrelated antibiotics like tetracycline. It shares 61% similarity with NorB, and is a structural homolog of Blt of Bacillus subtilis. Like NorA and NorB, NorC is regulated by mgrA, also known as NorR.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:16495280</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:23929475</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
