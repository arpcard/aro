            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>CDA-1 was recovered from a urine sample and is intermediate or resistant to third-generation cephalosporins and carbapenems. Susceptibility testing, isoelectric focusing, and analysis of outer membrane proteins showed that AmpC beta-lactamase expression combined with porin deficiency accounted for the carbapenem resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CDA-1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007650</oboInOwl:id>
        <rdfs:label>CDA-1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007650"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>CDA-1 was recovered from a urine sample and is intermediate or resistant to third-generation cephalosporins and carbapenems. Susceptibility testing, isoelectric focusing, and analysis of outer membrane proteins showed that AmpC beta-lactamase expression combined with porin deficiency accounted for the carbapenem resistance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25136020</oboInOwl:hasDbXref>
    </owl:Axiom>
