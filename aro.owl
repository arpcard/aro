    <!-- http://purl.obolibrary.org/obo/ARO_3004873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003415"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000330"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Point mutations in Neisseria gonorrhoeae dihydropteroate synthase folP prevent sulfonamide antibiotics from inhibiting its role in folate synthesis, thus conferring sulfonamide resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ngon_folP_SLF</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004873</oboInOwl:id>
        <rdfs:label>Neisseria gonorrhoeae folP with mutation conferring resistance to sulfonamides</rdfs:label>
    </owl:Class>
