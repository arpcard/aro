        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3001319</oboInOwl:id>
        <rdfs:label>fidaxomicin</rdfs:label>
    </owl:Class>
