        <owl:annotatedTarget>Actinomycins are peptide antibiotics that interact with DNA. This prevents RNA synthesis, thus preventing the production of proteins vital to the cell.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:2410919</oboInOwl:hasDbXref>
    </owl:Axiom>
    


