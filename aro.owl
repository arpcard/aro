        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Efflux protein facT confers resistance to factumycin. The gene has been heterologously expressed in S. coelicolor and its function confirmed. It is possible that this gene can export other kirromycin-like elfamycins, but this has not been tested.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>DOI:10.1039/C2MD20038D</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
