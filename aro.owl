    <!-- http://purl.obolibrary.org/obo/ARO_3004246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000359"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Two members of the Fom family have been identified, FomA and FomB. FomB must interact with FomA confer resistance to fosfomycin, however FomA is capable of conferring resistance alone.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004246</oboInOwl:id>
        <rdfs:label>Fom phosphotransferase family</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Fosfomycin is transported bacterial cells through transporters, one of them being glycerol-3-phosphate, which is encoded by the GlpT gene. Mutations in the GlpT gene can confer resistance to fosfomycin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004247</oboInOwl:id>
        <rdfs:label>antibiotic-resistant GlpT</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004248">
