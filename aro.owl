        <oboInOwl:hasExactSynonym>streptothricin F</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>yazumycin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:0000012</oboInOwl:id>
        <rdfs:label>streptothricin</rdfs:label>
    </owl:Class>
