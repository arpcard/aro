            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>mef(E) is a proton motive efflux pump in Streptococcus pneumoniae that confers resistance to macrolides. It is found on the same operon as mefA and the ABC-efflux pump mel.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>mef(E)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mefE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
