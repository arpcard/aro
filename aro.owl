    <!-- http://purl.obolibrary.org/obo/ARO_3009445 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007501"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>CDR2 encodes an efflux pump that helps expel toxic substances from fungal cells. The mutations enhance this pump&apos;s ability to remove caspofungin, which is an antifungal medication that normally kills fungi by disrupting cell wall synthesis. When CDR2 is mutated, it becomes overactive, rapidly pumping out caspofungin before the drug can effectively damage the fungal cell wall. This creates drug resistance, making caspofungin treatment ineffective and allowing the infection to persist despite medication.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009445</oboInOwl:id>
        <rdfs:label>Candida albicans CDR2 with mutations conferring resistance to caspofungin</rdfs:label>
    </owl:Class>
    


