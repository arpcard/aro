        <owl:annotatedTarget>Protection of antibiotic action target from antibiotic binding, which process will result in antibiotic resistance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32587401</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_0001004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0001004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115>Enzymatic inactivation of antibiotic to confer drug resistance.</obo:IAO_0000115>
