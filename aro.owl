        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000660</oboInOwl:id>
        <rdfs:label>lomefloxacin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000660"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Lomefloxacin is a difluoropiperazinyl quinolone, sharing similar activities with other fluoroquinolones. It is used to treat urinary tract infections. Relative to other fluoroquinolones, it has a longer half life and has higher serum concentrations.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:8394795</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000661 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115>Nalidixic acid is a quinolone derivative of naphthyridine active against many enterobacteria, but ineffective against Ps aeruginosa, Gram-positive bacteria, and anaerobes. Acquired resistance is common in nalidixic acid treatments.</obo:IAO_0000115>
