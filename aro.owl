        <obo:IAO_0000115>Mutations that occur in ald which decreases effective functioning of antibiotics.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004942</oboInOwl:id>
        <rdfs:label>antibiotic resistant ald</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004942"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007154"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>ald plays a role in cell wall synthesis as L-alanine is an important constituent of the peptidoglycan layer. Resistance due to mutations in ald can cause cycloserine to not function.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004943</oboInOwl:id>
        <rdfs:label>cycloserine resistant ald</rdfs:label>
    </owl:Class>
    


