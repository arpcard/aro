    <!-- http://purl.obolibrary.org/obo/ARO_3004213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004212"/>
        <obo:IAO_0000115>GOB-18 is a member of subclass B3 GOB family of beta-lactamases isolated from Elizabethkingia meningoseptica. GOB-18 is unlike other subclass B3 beta-lactamases as it is fully active against a broad range of beta-lactam substrates using a single Zn(II) ion in its active site.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>GOB-18</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004213</oboInOwl:id>
        <rdfs:label>GOB-18</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>GOB-18 is a member of subclass B3 GOB family of beta-lactamases isolated from Elizabethkingia meningoseptica. GOB-18 is unlike other subclass B3 beta-lactamases as it is fully active against a broad range of beta-lactam substrates using a single Zn(II) ion in its active site.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:17403673</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:27458232</oboInOwl:hasDbXref>
    </owl:Axiom>
