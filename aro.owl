    <!-- http://purl.obolibrary.org/obo/ARO_3004365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004360"/>
        <obo:IAO_0000115>BSAC is a British inter-professional organisation involved in antibiotic education, research and leadership. Baquero F. found that the BSAC system recommends lower breakpoints than the consensus standard of all systems for antimicrobial susceptibility testing used in Europe (BSAC, DIN, SFM, SIR, NCCLS and WRG).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004365</oboInOwl:id>
        <rdfs:label>British Society for Antimicrobial Chemotherapy (BSAC)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>BSAC is a British inter-professional organisation involved in antibiotic education, research and leadership. Baquero F. found that the BSAC system recommends lower breakpoints than the consensus standard of all systems for antimicrobial susceptibility testing used in Europe (BSAC, DIN, SFM, SIR, NCCLS and WRG).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:2226478</oboInOwl:hasDbXref>
    </owl:Axiom>
    


