        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000708"/>
        <obo:IAO_0000115>Beta-tubulin is a target for benzimidazole compounds when treating against fungi.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009321</oboInOwl:id>
        <rdfs:label>fungal cytoskeleton targeted by antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009322">
