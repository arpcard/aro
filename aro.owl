    <!-- http://purl.obolibrary.org/obo/ARO_3000333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000201"/>
