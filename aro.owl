    <!-- http://purl.obolibrary.org/obo/ARO_0000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115>Moxifloxacin is a fourth generation synthetic fluoroquinolone chemotherapeutic agent, and has been shown to be significantly more active than levofloxacin (4 to 8 times more) against Streptococcus pneumoniae. It acts by inhibiting bacterial DNA topoisomerases.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:151096-09-2</oboInOwl:hasDbXref>
