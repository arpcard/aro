    <!-- http://purl.obolibrary.org/obo/ARO_3009206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009200"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cyp51 are subtypes of P450 genes that are essential to the ergosterol biosynthesis pathway. When mutated in fungal species, these genes can confer resistance against azole drugs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009206</oboInOwl:id>
        <rdfs:label>Aspergillus terreus cyp51a with mutations conferring resistance to itraconazole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009207">
