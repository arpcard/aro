            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Proteins involved in restructuring of the cell wall, causing antibiotic resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000012</oboInOwl:id>
        <rdfs:label>protein(s) conferring antibiotic resistance via molecular bypass</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000013">
