    <!-- http://purl.obolibrary.org/obo/ARO_3003832 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009123"/>
        <obo:IAO_0000115>Ticarcillin is a carboxypenicillin used for the treatment of Gram-negative bacteria, particularly P. aeruginosa. Ticarcillin&apos;s antibiotic properties arise from its ability to prevent cross-linking of peptidoglycan during cell wall synthesis, when the bacteria try to divide, causing cell death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:34787-01-4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:9587</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL1449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:36921</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Ticarcilina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ticarcilline</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Ticarcillinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003832</oboInOwl:id>
        <rdfs:label>ticarcillin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ticarcillin is a carboxypenicillin used for the treatment of Gram-negative bacteria, particularly P. aeruginosa. Ticarcillin&apos;s antibiotic properties arise from its ability to prevent cross-linking of peptidoglycan during cell wall synthesis, when the bacteria try to divide, causing cell death.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:21504594</oboInOwl:hasDbXref>
