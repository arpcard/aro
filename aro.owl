        <obo:IAO_0000115>A combination of variant types.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009574</oboInOwl:id>
