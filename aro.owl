            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>ParE is a subunit of topoisomerase IV, which decatenates and relaxes DNA to allow access to genes for transcription or translation. Mutations in ParE prevents antibiotics from inhibiting DNA synthesis, thus conferring resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000115</oboInOwl:id>
        <rdfs:label>antibiotic resistant DNA topoisomerase subunit parE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000116 -->

