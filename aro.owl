                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MexAB-OprM is a multidrug efflux protein expressed in the Gram-negative Pseudomonas aeruginosa. MexA is the membrane fusion protein; MexB is the inner membrane transporter; and OprM is the outer membrane channel. MexAB-OprM is associated with resistance to fluoroquinolones, chloramphenicol, erythromycin, azithromycin, novobiocin, and certain β-lactams and lastly over-expression is linked to colistin resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MexAB-OprM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000386</oboInOwl:id>
        <rdfs:label>MexAB-OprM</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000386"/>
