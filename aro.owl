        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ribosomal RNA (rRNA) methyltransferases are a functional class of enzymes which catalyze the addition of S-adenosylmethionine to specific nucleotide bases in ribosomal RNA. The addition of a methyl group at select positions is associated with antibiotic resistance via antibiotic target protection.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:1929280</oboInOwl:hasDbXref>
    </owl:Axiom>
    


