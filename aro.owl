        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115>A class of compounds containing an aromatic moiety and an aliphatic chain, produced as a bacterial metabolite and exhibiting antibiotic properties to many gram-positive pathogens.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3005168</oboInOwl:id>
        <rdfs:label>ansamycin antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3005169 -->

