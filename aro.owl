        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115>Alkaloids are naturally occurring organic compounds containing the element nitrogen. Some alkaloid compounds exhibit specific antibacterial activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3005169</oboInOwl:id>
        <rdfs:label>alkaloids with antibiotic activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3005170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3005170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115>A metallophore is any organic substance capable of carrying a metallic element such as zinc or iron, typically through chelation. Some metallophores exhibit specific antibiotic activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3005170</oboInOwl:id>
