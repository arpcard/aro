    <!-- http://purl.obolibrary.org/obo/ARO_3009572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009567"/>
        <obo:IAO_0000115>The gene has been detected in the query more than once and at least one copy encodes a nucleotide variant.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009572</oboInOwl:id>
        <rdfs:label>nucleotide variant detected in multi-copy gene</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009567"/>
        <obo:IAO_0000115>The sequencing reads support a mixed population, of which a fraction encode a nucleotide variant.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009573</oboInOwl:id>
        <rdfs:label>low frequency variant detected</rdfs:label>
    </owl:Class>
    


