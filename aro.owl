    <!-- http://purl.obolibrary.org/obo/ARO_3009405 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009200"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009175"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Carbendazim is a member of the class of benzimidazoles that is 2-aminobenzimidazole in which the primary amino group is substituted by a methoxycarbonyl group. It is a carbamate ester and a benzimidazolylcarbamate fungicide. Mutations in Cyp51 genes have shown resistance against these compounds.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009405</oboInOwl:id>
        <rdfs:label>Zymoseptoria tritici Cyp51 with mutations conferring resistance to carbendazim</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009405"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
