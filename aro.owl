            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>EdeQ is an N-acetyltransferase enzyme that confers high-level self-resistance to edeine in Brevibacillus brevis, a natural edeine producer. EdeQ converts active edeine to N-acetyledeine, which is ineffective in vivo.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EdeQ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
