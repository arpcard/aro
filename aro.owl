    <!-- http://purl.obolibrary.org/obo/ARO_3004275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000218"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A category of aminoglycoside O-nucleotidyltransferase enzymes with modification regiospecificity based at the 3&apos;&apos;-hydroxyl group of the respective antibiotic. These enzymes inactivate aminoglycoside antibiotics by transfer of an AMP group from an ATP substrate to the 3&apos;&apos;-hydroxyl group of the compound.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004275</oboInOwl:id>
        <rdfs:label>ANT(3&apos;&apos;)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004275"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A category of aminoglycoside O-nucleotidyltransferase enzymes with modification regiospecificity based at the 3&apos;&apos;-hydroxyl group of the respective antibiotic. These enzymes inactivate aminoglycoside antibiotics by transfer of an AMP group from an ATP substrate to the 3&apos;&apos;-hydroxyl group of the compound.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:20833577</oboInOwl:hasDbXref>
    </owl:Axiom>
    


