                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>fabI is a enoyl-acyl carrier reductase used in lipid metabolism and fatty acid biosynthesis. The bacterial biocide Triclosan blocks the final reduction step in fatty acid elongation, inhibiting biosynthesis. Point mutations in fabI can confer resistance to Triclosan and Isoniazid.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Ecol_fabI_MULT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004045</oboInOwl:id>
        <rdfs:label>Escherichia coli fabI mutations conferring resistance to isoniazid and triclosan</rdfs:label>
    </owl:Class>
