    <!-- http://purl.obolibrary.org/obo/ARO_3003392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003416"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>katG is a catalase-peroxidase that catalyzes the activation of isoniazid. Isoniazid inhibits mycolic acid synthesis, which prevents cell wall synthesis in mycobacteria. Mutations in katG results in inability to activate isoniazid. Over 280 different mutations have been documented in PubMed for katG, with mutations to Ser315 being the most prevalent.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mtub_katG_INH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rv1908c</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003392</oboInOwl:id>
        <rdfs:label>Mycobacterium tuberculosis katG mutations conferring resistance to isoniazid</rdfs:label>
    </owl:Class>
