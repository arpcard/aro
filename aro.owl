        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ampR is a regulatory gene that plays an essential role in regulating antibiotic resistance in P. aeruginosa. Mutation in ampR leads to its loss of control over blaPDC-16, allowing overexpression of blaPDC-16 and further resistance to aztreonam.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:37070974</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007491"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Paer_ampR_ATM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


