        <oboInOwl:hasExactSynonym>Pentacef</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tazicef</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Tazidime</oboInOwl:hasExactSynonym>
