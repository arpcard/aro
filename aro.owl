                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The fungal Cyp51 enzyme system belongs to the broader P450 family. It is integral to ergosterol synthesis. Azoles target lanosterol demethylase thereby halting ergosterol production and ultimately compromises fungal cell membrane integrity. Mutations to Cyp51 genes have been shown to inhibit azole activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009541</oboInOwl:id>
        <rdfs:label>Tapesia acuformis Cyp51 with mutations conferring resistance to flusilazole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009200"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009408"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The fungal Cyp51 enzyme system belongs to the broader P450 family. It is integral to ergosterol synthesis. Azoles target lanosterol demethylase thereby halting ergosterol production and ultimately compromises fungal cell membrane integrity. Mutations to Cyp51 genes have been shown to inhibit azole activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009542</oboInOwl:id>
        <rdfs:label>Tapesia yallundae Cyp51 with mutations conferring resistance to flusilazole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009546"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009186"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The Cyp51A enzyme plays a key role in sterol biosynthesis in fungi. While azoles target lanosterol demethylase to disrupt ergosterol production, benomyl functions differently as a benzimidazole, binding to beta-tubulin and preventing microtubule assembly. Although Cyp51A is not directly involved in the benomyl target pathway, concurrent mutations in sterol biosynthesis genes like Cyp51A have been associated in some studies.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009543</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Cyp51A with mutations conferring resistance to benomyl</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009546"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009175"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The Cyp51A enzyme plays a key role in sterol biosynthesis in fungi. While azoles target lanosterol demethylase to disrupt ergosterol production, carbendazim functions differently as a benzimidazole, binding to beta-tubulin and preventing microtubule assembly. Although Cyp51A is not directly involved in the benomyl target pathway, concurrent mutations in sterol biosynthesis genes like Cyp51A have been associated in some studies.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009544</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Cyp51A with mutations conferring resistance to carbendazim</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009547"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009185"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cytochrome P450 enzyme Cyp51 is central to fungal ergosterol production. Strobilurin fungicides act on the mitochondrial respiratory chain by binding to the Qo site of cytochrome b, thereby inhibiting electron transport and ATP synthesis. Although strobilurins do not directly target Cyp51, mutations in Cyp51 and other sterol biosynthesis genes can influence overall fungal fitness and occasionally contribute to conferred resistance to other drug classes such as strobilurins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009545</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Cyp51A with mutations conferring resistance to azoxystrobin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007522"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009317"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cytochrome P450 enzyme family is central to multiple biosynthetic pathways in fungi, inclusive of sterol synthesis. Benzimidazole fungicides primarily target beta-tubulin to prevent microtubule assembly and cell division. Mutations in certain P450 enzymes have been observed to confer benzimidazole resistance by altering fungal metabolism, cell wall composition, or membrane composition even though P450 enzymes are not the direct drug target.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009546</oboInOwl:id>
        <rdfs:label>benzimidazole resistant fungal cytochrome P450 enzyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007522"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009305"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cytochrome P450 enzyme family is integral to fungal metabolism inclusive of sterol biosynthesis. Strobilurin fungicides target the Qo site of cytochrome b in the mitochondrial electron transport chain, inhibiting respiration and ATP production. Although strobilurins do not directly target P450 enzymes, mutations in certain fungal P450s can confer strobilurin resistance by altering cellular metabolism, detoxification pathways, or membrane composition.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009547</oboInOwl:id>
        <rdfs:label>strobilurin resistant fungal cytochrome P450 enzyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009547"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009304"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cytochrome P450 enzyme Cyp51 is central to fungal ergosterol production. Strobilurin fungicides act on the mitochondrial respiratory chain by binding to the Qo site of cytochrome b, thereby inhibiting electron transport and ATP synthesis. Although strobilurins do not directly target Cyp51, mutations in Cyp51 and other sterol biosynthesis genes can influence overall fungal fitness and occasionally contribute to conferred resistance to other drug classes such as strobilurins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009548</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Cyp51A with mutations conferring resistance to pyraclostrobin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009549 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007522"/>
        <obo:IAO_0000115>The cytochrome P450 enzyme family is central to several fungal metabolisms, inclusive of sterol biosynthesis. Succinate dehydrogenase inhibitor (SDHI) fungicides target the SDH complex in the mitochondrial electron transport chain, blocking respiration and ATP production. Although SDHIs do not directly target P450 enzymes, mutations or altered expression in certain fungal P450s can affect drug detoxification and cellular metabolism, thereby contributing to conferred resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009549</oboInOwl:id>
        <rdfs:label>succinate dehydrogenase inhibitor resistant fungal cytochrome P450 enzyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009549"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009186"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cytochrome P450 enzyme family is central to several fungal metabolisms, inclusive of sterol biosynthesis. Succinate dehydrogenase inhibitor (SDHI) fungicides target the SDH complex in the mitochondrial electron transport chain, blocking respiration and ATP production. Although SDHIs do not directly target P450 enzymes, mutations or altered expression in certain fungal P450s can affect drug detoxification and cellular metabolism, thereby contributing to conferred resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009550</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Cyp51A with mutations conferring resistance to boscalid</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009549"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009552"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cytochrome P450 enzyme family is central to several fungal metabolisms, inclusive of sterol biosynthesis. Succinate dehydrogenase inhibitor (SDHI) fungicides target the SDH complex in the mitochondrial electron transport chain, blocking respiration and ATP production. Although SDHIs do not directly target P450 enzymes, mutations or altered expression in certain fungal P450s can affect drug detoxification and cellular metabolism, thereby contributing to conferred resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009551</oboInOwl:id>
        <rdfs:label>Aspergillus fumigatus Cyp51A with mutations conferring resistance to fluopyram</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009539"/>
        <obo:IAO_0000115>Fluopyram has a role as an succinate dehydrogenase inhibitor and an antifungal agrochemical.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:658066-35-4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL2286755</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:11158353</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009552</oboInOwl:id>
        <rdfs:label>fluopyram</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009552"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Fluopyram has a role as an succinate dehydrogenase inhibitor and an antifungal agrochemical.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32216079</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009553 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007499"/>
        <obo:IAO_0000115>Myclobutanil is a nitrile, a member of triazoles and a member of monochlorobenzenes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:88671-89-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL1904430</oboInOwl:hasDbXref>
