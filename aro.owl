    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000000"/>
        <obo:IAO_0000115>Tulathromycin is an antibacterial of the macrolide class of drugs. It is a 15-membered macrolide structure and considered a triamilide macrolide with three charged nitrogens. It is derived from azalide macrolides, such as azithromycin.</obo:IAO_0000115>
