    <!-- http://purl.obolibrary.org/obo/ARO_3005162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3005162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000133"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>FosA7.5 is a variant of the FosA7 gene. This gene is unique from FosA7 in that it is found in Escherichia coli as opposed to Salmonella enterica. It confers resistance to fosfomycin.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>FosA7.5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3005162</oboInOwl:id>
