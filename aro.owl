    <!-- http://purl.obolibrary.org/obo/ARO_3004721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004722"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3003413"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>RpsA, the 30S ribosomal protein S1 of Mycobacterium tuberculosis, is involved in trans-translation and is targeted by pyrazinonic acid, the active form of the antibiotic pyrazinamide, which disrupts the initiation of mRNA translation. Mutations in the amino acid sequence of rpsA can confer resistance to pyrazinamide maintaining rpsA function.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Mtub_rpsA_PZA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Rv1630</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004721</oboInOwl:id>
        <rdfs:label>Mycobacterium tuberculosis rpsA mutations conferring resistance to pyrazinamide</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004721"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>RpsA, the 30S ribosomal protein S1 of Mycobacterium tuberculosis, is involved in trans-translation and is targeted by pyrazinonic acid, the active form of the antibiotic pyrazinamide, which disrupts the initiation of mRNA translation. Mutations in the amino acid sequence of rpsA can confer resistance to pyrazinamide maintaining rpsA function.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:29921403</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:30337678</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:30402208</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:30858213</oboInOwl:hasDbXref>
