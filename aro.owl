        <rdfs:label>sitafloxacin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003690"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Sitafloxacin is a fluoroquinolone active against multi-resistant Gram-positive and negative pathogens. Sitafloxacin shows inhibitory activity against DNA gyrase and topoisomerase IV, which blocks bacterial DNA replication, thereby causing double-stranded breaks in the bacterial chromosome.</owl:annotatedTarget>
