    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010003"/>
        <obo:IAO_0000115>EmrE is a small multidrug transporter that functions as a homodimer and that couples the efflux of small polyaromatic cations from the cell with the import of protons down an electrochemical gradient. EmrE is found in E. coli and P. aeruginosa.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000264</oboInOwl:id>
        <rdfs:label>emrE</rdfs:label>
    </owl:Class>
    <owl:Axiom>
