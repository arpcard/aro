    <!-- http://purl.obolibrary.org/obo/ARO_3004273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004274"/>
