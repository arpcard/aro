    <!-- http://purl.obolibrary.org/obo/ARO_3007772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3005163"/>
        <obo:IAO_0000115>Valinomycin is a depsipeptide antibiotic which selectively translocates potassium across biologic membranes. This potassium ionophore was observed to inhibit phytohemagglutinin-stimulated blastogenesis and proliferation in human lymphocytes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CHEBI:28545</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL223643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:3000706</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007772</oboInOwl:id>
        <rdfs:label>valinomycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007772"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Valinomycin is a depsipeptide antibiotic which selectively translocates potassium across biologic membranes. This potassium ionophore was observed to inhibit phytohemagglutinin-stimulated blastogenesis and proliferation in human lymphocytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:1068473</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115>Bisindoles are structurally complex dimers and are intriguing targets for partial and total synthesis. They exhibit stronger biological activity than their corresponding monomeric units.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007773</oboInOwl:id>
        <rdfs:label>bis-indole alkaloid with antibiotic activity</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007773"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Bisindoles are structurally complex dimers and are intriguing targets for partial and total synthesis. They exhibit stronger biological activity than their corresponding monomeric units.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:34200196</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3007774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3007774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007773"/>
        <obo:IAO_0000115>Spongosorites has yielded a bis-indole alkaloid which we have named dragmacidin G. Dragmacidin G is the first in this series of compounds to have a pyrazine ring linking the two indole rings. It also has a rare N-(2-mercaptoethyl)-guanidine side chain. Dragmacidin G shows a broad spectrum of biological activity including inhibition of methicillin-resistant Staphylococcus aureus, Mycobacterium tuberculosis, Plasmodium falciparum, and a panel of pancreatic cancer cell lines.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PubChem:11260315</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3007774</oboInOwl:id>
        <rdfs:label>dragmacidin A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3007774"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Spongosorites has yielded a bis-indole alkaloid which we have named dragmacidin G. Dragmacidin G is the first in this series of compounds to have a pyrazine ring linking the two indole rings. It also has a rare N-(2-mercaptoethyl)-guanidine side chain. Dragmacidin G shows a broad spectrum of biological activity including inhibition of methicillin-resistant Staphylococcus aureus, Mycobacterium tuberculosis, Plasmodium falciparum, and a panel of pancreatic cancer cell lines.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:28085024</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:38206835</oboInOwl:hasDbXref>
    </owl:Axiom>
    


