        <owl:annotatedTarget>Cefazedone is a semisynthetic first-generation cephalosporin with antibacterial activity. Cefazedone binds to and inactivates penicillin-binding proteins (PBPs) located on the inner membrane of the bacterial cell wall.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:39575</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009111 -->

