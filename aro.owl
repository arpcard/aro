        <oboInOwl:id>ARO:0000021</oboInOwl:id>
        <rdfs:label>ribostamycin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_0000021"/>
