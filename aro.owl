    <!-- http://purl.obolibrary.org/obo/ARO_3000123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009657"/>
        <obo:IAO_0000115>Gramicidins are a family of antibiotics synthesized by Bacillus brevis. It includes the linear pentadecapeptides gramicidin A, B and C that make up the mixture gramicidin D. Gramicidin S is a cyclic peptide chain. Gramicidins are also components of tyrothricins, another mixture of antibiotics produced by Bacillus brevis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PubChem:16130140</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000123</oboInOwl:id>
        <rdfs:label>gramicidin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000123"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Gramicidins are a family of antibiotics synthesized by Bacillus brevis. It includes the linear pentadecapeptides gramicidin A, B and C that make up the mixture gramicidin D. Gramicidin S is a cyclic peptide chain. Gramicidins are also components of tyrothricins, another mixture of antibiotics produced by Bacillus brevis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18745784</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000100"/>
