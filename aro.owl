    <!-- http://purl.obolibrary.org/obo/ARO_3009370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
        <obo:IAO_0000115>MRP proteins are Mitochondrial Ribosomal Proteins, that as the name suggests, encode proteins that can be found exclusively in the ribosomes within mitochondria. In addition to translation, they also play a role in metabolism. In humans, mutations in some of these proteins can result in metabolic disorders. In fungi, mutations in these proteins can confer antifungal resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009370</oboInOwl:id>
        <rdfs:label>antifungal resistant MRPL</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009370"/>
        <obo:IAO_0000115>Mutations in fungal MRP proteins can result in resistance against the echinocandin class of antifungal compounds.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009371</oboInOwl:id>
        <rdfs:label>echinocandin resistant MRPL</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009371"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007501"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009373"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Mutations in MRPL11 has shown conferred resistance to the echinocandin caspofungin.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009372</oboInOwl:id>
        <rdfs:label>Nakaseomyces glabratus MRPL11 mutations with resistance to caspofungin</rdfs:label>
    </owl:Class>
