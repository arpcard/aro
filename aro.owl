            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Point mutations in Salmonella gallinarum dihydropteroate synthase folP altered the stability of the protein, thus conferring sulfonamide resistance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Sgal_folP_SLF</oboInOwl:hasExactSynonym>
