    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009425"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3007507"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>MDR1 encodes a membrane-bound efflux pump which can confer resistance to antifungal compounds when the gene is subject to a gain of function mutation. Terbinafine inhibits squalene epoxidase in fungi but if this enzyme remains functional then ergosterol production continues allowing the fungus to survive despite drug exposure.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009449</oboInOwl:id>
        <rdfs:label>Microsporum canis MDR1 with mutations conferring resistance to terbinafine</rdfs:label>
    </owl:Class>
    


