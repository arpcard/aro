    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004392"/>
        <obo:IAO_0000115>A developed TLC plate is dipped into or sprayed with a microbial suspension and then incubated. Live microbial cells are visualized using tetrazolium salts.</obo:IAO_0000115>
