    <!-- http://purl.obolibrary.org/obo/ARO_3004139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004268"/>
