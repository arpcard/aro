        <owl:annotatedTarget>vanB_cluster</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000002"/>
        <obo:IAO_0000115>Reduction in permeability to antibiotic, generally through reduced production of porins, can provide resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000244</oboInOwl:id>
        <rdfs:label>reduced permeability to antibiotic</rdfs:label>
    </owl:Class>
    <owl:Axiom>
