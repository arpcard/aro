        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>fabG is a bacterial 3-oxoacyl enoyl-acyl carrier reductase (ENR) isozyme. As with other ENRs, mutations in fabG are shown to confer resistance to the biocide triclosan.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:27577999</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000831"/>
        <obo:IAO_0000115>CpxR is directly involved in activation of expression of RND efflux pump MexAB-OprM in P. aeruginosa. CpxR is required to enhance mexAB-oprM expression and drug resistance, in the absence of repressor MexR.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Paer_CpxR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004054</oboInOwl:id>
        <rdfs:label>Pseudomonas aeruginosa CpxR</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>CpxR is directly involved in activation of expression of RND efflux pump MexAB-OprM in P. aeruginosa. CpxR is required to enhance mexAB-oprM expression and drug resistance, in the absence of repressor MexR.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:27736975</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004054"/>
