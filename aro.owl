    <!-- http://purl.obolibrary.org/obo/ARO_3000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3002976"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000081"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>VanH is a D-specific alpha-ketoacid dehydrogenase that synthesizes D-lactate. D-lactate is incorporated into the end of the peptidoglycan subunits, decreasing vancomycin binding affinity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
