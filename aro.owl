        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Aminoglycoside acetyltransferase enzymes modify aminoglycoside antibiotics by catalyzing the transfer of an acetyl group to one of the amino groups present in aminoglycosides, using acetyl coenzyme A as a donor substrate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:20833577</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000557"/>
