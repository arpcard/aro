        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009277</oboInOwl:id>
        <rdfs:label>Colletotrichum gloeosporioides cytochrome b with mutations conferring resistance to picoxystrobin</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009304"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3009344"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Strobilurins, also known as QOI fungicides, are a group of fungicides originally isolated from the fungus Strobilurus tenacellus that inhibit mitochondrial respiration by binding to Complex III in the electron transport chain thereby disrupting the fungus&apos;s ability to produce energy.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009278</oboInOwl:id>
        <rdfs:label>Colletotrichum gloeosporioides cytochrome b protein with mutations conferring resistance to pyraclostrobin</rdfs:label>
    </owl:Class>
    


