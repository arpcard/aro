    <!-- http://purl.obolibrary.org/obo/ARO_3000368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3002979"/>
