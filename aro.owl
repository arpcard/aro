        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>MCR-4.1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004326 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004305"/>
        <obo:IAO_0000115>Any Pseudomonas aeruginosa that has tested resistant (R) to at least one of the following: ciprofloxacin, levofloxacin.</obo:IAO_0000115>
