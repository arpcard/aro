    <!-- http://purl.obolibrary.org/obo/ARO_3009169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3007500"/>
        <obo:IAO_0000115>This compound inhibits sterol 14alpha-demethylase and is used as a fungicide for the control of powdery mildew, scab and other diseases on a variety of crops. It is a member of the following groups: monochlorobenzenes, imidazoles, (trifluoromethyl)benzenes, carboxamidine, ether and conazoles.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:68694-11-1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL463781</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:91699</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009169</oboInOwl:id>
        <rdfs:label>triflumizole</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>This compound inhibits sterol 14alpha-demethylase and is used as a fungicide for the control of powdery mildew, scab and other diseases on a variety of crops. It is a member of the following groups: monochlorobenzenes, imidazoles, (trifluoromethyl)benzenes, carboxamidine, ether and conazoles.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:10919801</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3009170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009165"/>
        <obo:IAO_0000115>This chemical compound is produced by the myxobacterium Myxococcus fulvus. It is an inhibitor of the mitochondrial cytochrome bc1 complex (coenzyme Q - cytochrome c reductase). It is a competitive inhibitor of ubiquinol, and binds at the quinol oxidation (Qo) site of the bc1 complex, blocking electron transfer to the Rieske iron-sulfur protein.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CAS:76706-55-3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CHEBI:25461</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ChEMBL:CHEMBL454568</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PubChem:10972974</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009170</oboInOwl:id>
        <rdfs:label>myxothiazole</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3009170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>This chemical compound is produced by the myxobacterium Myxococcus fulvus. It is an inhibitor of the mitochondrial cytochrome bc1 complex (coenzyme Q - cytochrome c reductase). It is a competitive inhibitor of ubiquinol, and binds at the quinol oxidation (Qo) site of the bc1 complex, blocking electron transfer to the Rieske iron-sulfur protein.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:2547800</oboInOwl:hasDbXref>
    </owl:Axiom>
    


