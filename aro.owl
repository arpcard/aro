        <oboInOwl:hasDbXref>PubChem:62959</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Trovan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>alatrofloxacin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3000664</oboInOwl:id>
        <rdfs:label>trovafloxacin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000664"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Trovafloxacin is a trifluoroquinalone with a broad spectrum of activity that acts by inhibiting the uncoiling of supercoiled DNA. While potent against many Gram-positive and Gram-negative bacteria, it is less active against pseudomonads and Cl. difficile. It is usually taken as the prodrug trovafloxacin mesylate or alatrofloxacin mesylate for oral or intravenous administration, respectively.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:8043036</oboInOwl:hasDbXref>
