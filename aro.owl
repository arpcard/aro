        <oboInOwl:hasExactSynonym>8001-54-5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Benzalkonium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>D00857</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Zephiran chloride</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3003823</oboInOwl:id>
        <rdfs:label>benzalkonium chloride</rdfs:label>
    </owl:Class>
    <owl:Axiom>
