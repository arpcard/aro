        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000568"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Subclass B1 possess a binuclear active site.  Within this active site can be either one or two Zn(II) ions.  This subclass is able to hydrolyze penicillins, cephalosporins and carbapenems.  This is the most clinically relevant subclass of MBLs.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:18563261</oboInOwl:hasDbXref>
    </owl:Axiom>
    


