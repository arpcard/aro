        <owl:annotatedTarget>porin_OmpC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/antibiotic_resistance#CARD_Short_Name"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115>Nitroimidazoles are a group of drugs that have both antiprotozoal and antibacterial activity, classified with respect to the location of the nitro functional group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004115</oboInOwl:id>
        <rdfs:label>nitroimidazole antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_1000003"/>
        <obo:IAO_0000115>Nitrofurans are chemotherapeutic agents with antibacterial and antiprotozoal activity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004116</oboInOwl:id>
        <rdfs:label>nitrofuran antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004282"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ARO_2000000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3004121"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A ToxR-Regulated outer membrane porin. In Vibrio cholerae, ToxR controls resistance to P2 (a BPI-derived antimicrobial peptide) by regulating the production of OmpU. OmpU also confers resistance to polymyxin B sulfate.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Vcho_OmpU</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3004117</oboInOwl:id>
        <rdfs:label>Vibrio cholerae OmpU</rdfs:label>
    </owl:Class>
