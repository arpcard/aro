    <!-- http://purl.obolibrary.org/obo/ARO_3009234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3009234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3009195"/>
        <obo:IAO_0000115>Fungal Hmg enzymes which include mutations or other modifications to confer resistance to antifungal drug compounds. The Hmg pathway has roles in steroid synthesis and metabolic function in most eukaryotes, and within fungi is essential to ergosterol synthesis, but may also play significant roles in cell cycle function as well.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id>ARO:3009234</oboInOwl:id>
        <rdfs:label>antifungal susceptible HMG-CoA reductase</rdfs:label>
    </owl:Class>
    


